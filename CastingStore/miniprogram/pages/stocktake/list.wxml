<view class="page">
  <help-bubble topic="stocktake.list" />
  <view class="card">
    <view class="row-between">
      <view>
        <view class="kpi-label">本月盘点</view>
        <view class="card-title" style="margin-top: 6rpx;">{{currentPeriod || '--'}}</view>
        <view class="small muted">已完成 {{monthCompleted}} 张 · 进行中 {{monthPending}} 张</view>
        <help-bubble inline topic="stocktake.flow" label="盘点流转说明" />
      </view>
      <text class="tag {{monthCompleted > 0 ? 'tag-primary' : 'tag-warn'}}">{{monthCompleted > 0 ? '已完成' : '待盘点'}}</text>
    </view>

    <block wx:if="{{canAdjust}}">
      <view class="divider"></view>
      <view class="field">
        <view class="field-label">盘点期间</view>
        <picker class="field-picker" mode="date" fields="month" value="{{createPeriod}}" bindchange="onCreatePeriod">
          <view>{{createPeriod || '选择月份'}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">盘点仓库</view>
        <picker class="field-picker" mode="selector" range="{{warehouseNames}}" value="{{warehouseIndex}}" bindchange="onWarehouse">
          <view>{{warehouseNames[warehouseIndex] || '默认仓库'}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">商品供应商</view>
        <picker class="field-picker" mode="selector" range="{{supplierNames}}" value="{{supplierIndex}}" bindchange="onSupplier">
          <view>{{supplierNames[supplierIndex] || '全部供应商'}} ▾</view>
        </picker>
      </view>
      <button class="btn btn-primary btn-block" bindtap="onCreate" disabled="{{creating}}">新建盘点单</button>
    </block>
  </view>

  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无盘点单，先新建一张月度盘点吧</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
    <view class="row-between">
      <view class="row" style="gap: 10rpx;">
        <text class="tag">{{item.no}}</text>
        <text class="small muted">{{item.period}}</text>
      </view>
      <text class="tag {{item.tag_class}}">{{item.status}}</text>
    </view>
    <view class="card-title" style="margin-top: 16rpx;">{{item.warehouse_name}}</view>
    <view class="small muted" wx:if="{{item.supplier_name}}" style="margin-top: 4rpx;">供应商 {{item.supplier_name}}</view>
    <view class="small muted" style="margin-top: 6rpx;">
      {{item.date_text}} · {{item.item_count}} 个商品 · 差异 {{item.diff_count}} 个
    </view>
    <view class="row-between" style="margin-top: 14rpx;">
      <text class="small muted">盘盈 {{item.gain_text}} · 盘亏 {{item.loss_text}}</text>
      <text wx:if="{{showCost}}" class="small muted">金额 +{{item.gain_amount_text}} / -{{item.loss_amount_text}}</text>
    </view>
    <view class="small muted" wx:if="{{item.completed_text}}" style="margin-top: 6rpx;">完成于 {{item.completed_text}}</view>
  </view>

  <view class="footer-placeholder"></view>
</view>
