<view class="page">
  <help-bubble topic="tradeins.list" />
  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <help-bubble inline topic="tradein.flow" label="回收流转说明" />

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无回收单</view>

  <view
    wx:for="{{list}}"
    wx:key="_id"
    class="card"
    data-id="{{item._id}}"
    bindtap="onDetail"
  >
    <view class="row-between">
      <view class="grow">
        <view class="row" style="gap: 10rpx;">
          <text class="bold">{{item.rod_text}}</text>
          <text class="tag {{item.tag_class}}">{{item.status}}</text>
        </view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.no}} · {{item.date_text}}</view>
      </view>
      <view style="text-align: right;">
        <view class="bold">¥{{item.credit_text}}</view>
        <view class="small muted">旧竿折价</view>
      </view>
    </view>
    <view class="small muted" style="margin-top: 10rpx;">
      订单 {{item.order_no}} · 客户 {{item.customer_name || '-'}}
    </view>
    <view class="small muted" wx:if="{{item.defect_desc}}">故障：{{item.defect_desc}}</view>
    <view class="small muted" wx:if="{{item.product_name}}">已入库：{{item.product_name}}</view>
  </view>

  <view class="footer-placeholder"></view>
</view>
