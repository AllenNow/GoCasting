<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{order}}">
    <view class="card">
      <view class="row-between">
        <view class="row" style="gap: 12rpx;">
          <text class="tag">{{order.platform}}</text>
          <text class="tag">{{isDropship ? '代发' : '自仓'}}</text>
        </view>
        <text class="tag tag-warn">{{order.status}}</text>
      </view>
      <view class="card-title" style="margin-top: 16rpx;">{{order.no}}</view>
      <view class="small muted" style="margin-top: 6rpx;">{{dateText}}<text wx:if="{{shippedText}}"> · 发货 {{shippedText}}</text></view>
      <view class="divider"></view>
      <view class="row-between">
        <view>
          <view class="small muted">实收金额</view>
          <view class="value-lg">¥{{paidText}}</view>
        </view>
        <view wx:if="{{showCost}}" style="text-align: right;">
          <view class="small muted">毛利 / 毛利率</view>
          <view class="value-lg">¥{{profitText}}</view>
          <view class="small muted">{{profitRate}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">商品明细</view>
      <view class="divider"></view>
      <view wx:for="{{order.items}}" wx:key="index" class="list-item">
        <view class="grow">
          <view class="bold">{{item.product_name}}</view>
          <view class="small muted">{{item.sku_code}} · ¥{{item.price}} × {{item.qty}}</view>
        </view>
        <text class="bold">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{showCost}}">
      <view class="card-title">毛利构成</view>
      <view class="divider"></view>
      <view class="list-item"><text>实收</text><text>¥{{paidText}}</text></view>
      <view class="list-item" wx:if="{{hasRefund}}"><text>退款</text><text>-¥{{refundText}}</text></view>
      <view class="list-item"><text>商品成本</text><text>-¥{{costText}}</text></view>
      <view class="list-item" wx:if="{{hasRefundCost}}"><text>退回成本回冲</text><text>+¥{{refundCostText}}</text></view>
      <view class="list-item" wx:if="{{isDropship}}"><text>代发运费</text><text>-¥{{dropshipFreightText}}</text></view>
      <view class="list-item"><text>可归因费用</text><text>-¥{{feeText}}</text></view>
      <view class="divider"></view>
      <view class="row-between bold"><text>毛利</text><text>¥{{profitText}}</text></view>
    </view>

    <view class="card" wx:if="{{isDropship}}">
      <view class="card-title">代发信息</view>
      <view class="divider"></view>
      <view class="list-item"><text class="muted">供应商</text><text>{{order.supplier_name || '-'}}</text></view>
      <view wx:if="{{showCost}}">
        <view class="list-item"><text class="muted">代发运费</text><text>¥{{dropshipFreightText}}</text></view>
        <view class="list-item"><text class="muted">应付供应商</text><text>¥{{payableText}}</text></view>
        <view class="list-item"><text class="muted">已结算</text><text>¥{{supplierPaidText}}</text></view>
        <view class="list-item"><text class="muted">未结算</text><text class="bold">¥{{supplierRemainText}}</text></view>
        <block wx:if="{{canSettle}}">
          <view class="divider"></view>
          <view class="field">
            <view class="field-label">本次结算</view>
            <input class="field-input" type="digit" value="{{settle_amount}}" data-field="settle_amount" bindinput="onSettleField" />
          </view>
          <view class="field">
            <view class="field-label">支出账户</view>
            <picker class="field-picker" mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="onAccountChange">
              <view>{{accountNames[accountIndex] || '不指定账户'}} ▾</view>
            </picker>
          </view>
          <button class="btn btn-primary btn-sm" style="margin-top: 16rpx;" bindtap="onSettle">结算供应商</button>
        </block>
      </view>
    </view>

    <view class="card" wx:if="{{afterSales.length > 0}}">
      <view class="card-title">售后记录</view>
      <view class="divider"></view>
      <view wx:for="{{afterSales}}" wx:key="_id" class="list-item" data-id="{{item._id}}" bindtap="goAfterSaleDetail">
        <view class="grow">
          <view class="bold">{{item.no}} · {{item.type}}</view>
          <view class="small muted">{{item.items_text}}</view>
          <view class="small muted">{{item.date_text}}</view>
        </view>
        <view style="text-align: right;">
          <view class="bold">¥{{item.refund_text}}</view>
          <text class="tag {{item.status === '已完成' ? '' : 'tag-warn'}}">{{item.status}}</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{expenses.length > 0}}">
      <view class="card-title">费用明细</view>
      <view class="divider"></view>
      <view wx:for="{{expenses}}" wx:key="_id" class="list-item">
        <view>
          <view>{{item.type}}</view>
          <view class="small muted" wx:if="{{item.payee}}">收款人：{{item.payee}}</view>
        </view>
        <text class="bold">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">收货信息</view>
      <view class="divider"></view>
      <view class="list-item"><text class="muted">买家</text><text>{{order.buyer_name || '-'}}</text></view>
      <view class="list-item"><text class="muted">手机号</text><text>{{order.buyer_phone || '-'}}</text></view>
      <view class="list-item"><text class="muted">地址</text><text style="max-width: 70%; text-align: right;">{{order.address || '-'}}</text></view>
      <view class="list-item"><text class="muted">平台单号</text><text>{{order.platform_order_no || '-'}}</text></view>
      <view class="list-item"><text class="muted">快递单号</text><text selectable>{{order.tracking_no || '-'}}</text></view>
      <view class="list-item"><text class="muted">备注</text><text>{{order.note || '-'}}</text></view>
    </view>

    <view class="card" wx:if="{{canShip}}">
      <view class="card-title">发货信息</view>
      <view class="divider"></view>
      <view class="field">
        <view class="field-label">快递单号</view>
        <input class="field-input" placeholder="必填，发货后写入订单与出库流水" value="{{trackingNo}}" bindinput="onTrackingInput" />
      </view>
      <view class="small muted">发货会扣减库存并生成销售出库流水，请核对快递单号。</view>
    </view>

    <view class="footer-placeholder"></view>
    <view class="footer-bar">
      <button wx:if="{{canEdit}}" class="btn btn-ghost grow" bindtap="goEdit">编辑</button>
      <button wx:if="{{canDelete}}" class="btn btn-danger grow" bindtap="onDelete">删除</button>
      <button wx:if="{{canAfterSale}}" class="btn btn-ghost grow" bindtap="goAfterSale">售后</button>
      <button wx:if="{{canCancel}}" class="btn btn-ghost grow" bindtap="onCancel">取消订单</button>
      <button wx:if="{{canRefund}}" class="btn btn-danger grow" bindtap="onRefund">退款</button>
      <button wx:if="{{canShip}}" class="btn btn-primary grow" bindtap="onShip">发货</button>
      <button wx:if="{{canComplete}}" class="btn btn-primary grow" bindtap="onComplete">确认完成</button>
    </view>
  </block>
</view>
