<view class="page">
  <view class="card">
    <view class="row-between">
      <view>
        <view class="kpi-label">筛选结果 · {{totalOrders}} 单</view>
        <view class="card-title" style="margin-top: 6rpx;">实收 ¥{{totalSales}}</view>
        <view class="small muted" wx:if="{{showCost}}">毛利 ¥{{totalProfit}}</view>
      </view>
      <view class="row" style="gap: 12rpx;">
        <button class="btn btn-ghost btn-sm" bindtap="goAfterSales">售后单</button>
        <button class="btn btn-primary btn-sm" bindtap="goNew">新建订单</button>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <view class="card row" style="display: flex; gap: 12rpx;">
    <input
      class="grow"
      placeholder="搜索单号 / 平台单号 / 买家"
      value="{{keyword}}"
      bindinput="onKeyword"
      confirm-type="search"
      bindconfirm="doSearch"
    />
    <button class="btn btn-sm" bindtap="doSearch">搜索</button>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无订单</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
    <view class="row-between">
      <view class="row" style="gap: 10rpx;">
        <text class="tag">{{item.platform}}</text>
        <text wx:if="{{item.fulfill_mode === '代发'}}" class="tag">代发</text>
        <text class="small muted">{{item.no}}</text>
      </view>
      <text class="tag {{item.tag_class}}">{{item.status}}</text>
    </view>
    <view class="row-between" style="margin-top: 16rpx;">
      <view>
        <view class="bold">{{item.buyer_name || '未填写买家'}}</view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.date_text}} · {{item.items.length}} 件商品</view>
      </view>
      <view style="text-align: right;">
        <view class="bold">¥{{item.paid_text}}</view>
        <view class="small {{showCost ? 'muted' : 'muted'}}" wx:if="{{showCost}}">毛利 ¥{{item.profit_text}}</view>
        <view class="small muted" wx:else>实收</view>
      </view>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>
