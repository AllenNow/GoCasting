<view class="page">
  <help-bubble topic="purchase.list" />
  <view class="card">
    <view class="row-between">
      <view>
        <view class="kpi-label">采购单合计</view>
        <view class="card-title">¥{{totalAmount}}</view>
      </view>
      <view class="row" style="gap: 12rpx;">
        <button class="btn btn-sm" bindtap="goSuppliers">供应商</button>
        <button class="btn btn-primary btn-sm" bindtap="goNew">新建采购</button>
      </view>
    </view>
  </view>

  <help-bubble inline topic="purchase.flow" label="采购流转说明" />

  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无采购单</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
    <view class="row-between">
      <view class="row" style="gap: 10rpx;">
        <text class="tag {{item.tag_class}}">{{item.status}}</text>
        <text class="tag {{item.unpaid ? 'tag-danger' : 'tag-primary'}}">{{item.pay_text}}</text>
        <text class="small muted">{{item.no}}</text>
      </view>
      <text class="bold">¥{{item.total_text}}</text>
    </view>
    <view class="row-between" style="margin-top: 14rpx;">
      <view class="small muted">{{item.supplier_name || '未填供应商'}} · {{item.item_count}} 个商品</view>
      <view class="small muted">{{item.date_text}}</view>
    </view>
    <view class="small muted" wx:if="{{item.purchase_channel || item.channel_order_no || item.tracking_no}}" style="margin-top: 6rpx;">
      <text wx:if="{{item.purchase_channel}}">渠道 {{item.purchase_channel}}</text>
      <text wx:if="{{item.channel_order_no}}"> · 单号 {{item.channel_order_no}}</text>
      <text wx:if="{{item.tracking_no}}"> · 物流 {{item.tracking_no}}</text>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>
