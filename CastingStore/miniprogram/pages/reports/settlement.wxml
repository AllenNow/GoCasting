<view class="page">
  <help-bubble topic="reports.settlement" />
  <view wx:if="{{!allowed}}" class="empty">当前角色没有平台对账权限</view>
  <view wx:elif="{{loading && list.length === 0}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="card">
      <view class="row-between">
        <view class="card-title">对账信息</view>
        <text wx:if="{{exists}}" class="tag tag-primary">已有记录</text>
      </view>
      <view class="card-sub">差异 = 平台账单金额 - 系统实收（仅统计待发货 / 已发货 / 已完成订单）</view>
      <help-bubble inline topic="settlement.diff" label="差异说明" />
      <view class="divider"></view>

      <view class="field">
        <view class="field-label">平台</view>
        <picker class="field-picker" mode="selector" range="{{platforms}}" value="{{platformIndex}}" bindchange="onPlatform">
          <view>{{platforms[platformIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">账期</view>
        <picker class="field-picker" mode="date" fields="month" value="{{period}}" bindchange="onPeriod">
          <view>{{period}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">系统实收</view>
        <view class="field-picker">¥{{systemAmount}} · {{orderCount}} 单</view>
      </view>
      <view class="field">
        <view class="field-label">平台账单</view>
        <input class="field-input" type="digit" placeholder="平台结算金额" value="{{statement}}" bindinput="onStatement" />
      </view>
      <view class="field">
        <view class="field-label">差异</view>
        <view class="field-picker">
          <text class="tag {{diffClass}}">{{diff}}</text>
          <text class="small muted" style="margin-left: 8rpx;">{{diffLabel}}</text>
        </view>
      </view>
      <view class="field">
        <view class="field-label">差异原因</view>
        <input class="field-input" placeholder="差异不为 0 时必填" value="{{reason}}" bindinput="onReason" />
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <input class="field-input" placeholder="选填" value="{{note}}" bindinput="onNote" />
      </view>

      <button wx:if="{{canSave}}" class="btn btn-primary btn-block" style="margin-top: 20rpx;" bindtap="onSave" loading="{{saving}}">
        {{exists ? '更新对账' : '保存对账'}}
      </button>
      <view wx:else class="small muted" style="margin-top: 16rpx;">当前角色只读，只有老板或财务可以保存对账。</view>
    </view>

    <view class="card">
      <view class="card-title">历史对账</view>
      <view class="divider"></view>
      <view wx:if="{{list.length === 0}}" class="empty" style="padding: 24rpx 0;">暂无对账记录</view>
      <view
        wx:for="{{list}}"
        wx:key="_id"
        class="list-item"
        data-platform="{{item.platform}}"
        data-period="{{item.period}}"
        bindtap="onPick"
      >
        <view>
          <view class="bold">{{item.platform}} · {{item.period}}</view>
          <view class="small muted">账单 ¥{{item.statement_text}} · 系统 ¥{{item.system_text}} · {{item.order_count}} 单</view>
        </view>
        <view class="tag {{item.diff_class}}">{{item.diff_text}}</view>
      </view>
    </view>
  </block>
</view>
