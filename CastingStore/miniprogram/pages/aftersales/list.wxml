<view class="page">
  <view class="card">
    <view class="row-between">
      <view>
        <view class="kpi-label">售后单</view>
        <view class="card-title" style="margin-top: 6rpx;">共 {{list.length}} 单 · 待处理 {{pendingCount}}</view>
      </view>
      <button class="btn btn-ghost btn-sm" bindtap="goOrders">去订单售后</button>
    </view>
  </view>

  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无售后单，可在订单详情发起售后</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
    <view class="row-between">
      <view class="row" style="gap: 10rpx;">
        <text class="tag">{{item.no}}</text>
        <text wx:if="{{item.fulfill_mode === '代发'}}" class="tag">代发</text>
        <text class="small muted">{{item.order_no}}</text>
      </view>
      <text class="tag {{item.tag_class}}">{{item.status}}</text>
    </view>
    <view class="row-between" style="margin-top: 16rpx;">
      <view class="grow">
        <view class="bold">{{item.type}} · ¥{{item.refund_text}}</view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.items_text}}</view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.date_text}}</view>
      </view>
      <view style="text-align: right;">
        <view class="small muted">{{item.buyer_name || '未填写买家'}}</view>
        <view class="small muted">{{item.restock ? '回补库存' : '不回补'}}</view>
      </view>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>
