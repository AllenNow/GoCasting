<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{mode === 'create'}}">
    <view class="card" wx:if="{{order}}">
      <view class="row-between">
        <view class="row" style="gap: 10rpx;">
          <text class="tag">{{order.no}}</text>
          <text wx:if="{{isDropship}}" class="tag">代发</text>
        </view>
        <text class="tag tag-warn">{{order.status}}</text>
      </view>
      <view class="card-title" style="margin-top: 16rpx;">{{order.buyer_name || '未填写买家'}}</view>
      <view class="small muted" style="margin-top: 6rpx;">{{order.platform}} · 可退金额 ¥{{remainText}}</view>
    </view>

    <view class="card">
      <view class="card-title">售后商品</view>
      <view class="card-sub">可退数量已扣除历史已完成的售后单。</view>
      <view class="divider"></view>
      <view wx:for="{{items}}" wx:key="product_id" class="list-item">
        <view class="grow">
          <view class="bold">{{item.product_name}}</view>
          <view class="small muted">{{item.sku_code}} · ¥{{item.price_text}} · 可退 {{item.remaining_qty}}</view>
          <view wx:if="{{showCost}}" class="small muted">成本 ¥{{item.cost_text}}</view>
        </view>
        <input class="qty-input" type="number" value="{{item.qty}}" data-index="{{index}}" bindinput="onQty" />
      </view>
    </view>

    <view class="card">
      <view class="card-title">售后信息</view>
      <view class="card-sub" wx:if="{{isDropship}}">代发订单无自仓库存可回补，已发货部分退款将计入损耗。</view>
      <view class="divider"></view>
      <view class="field">
        <view class="field-label">售后类型</view>
        <picker class="field-picker" mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onType">
          <view>{{types[typeIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">退款金额</view>
        <input class="field-input" type="digit" placeholder="不得超过可退金额" value="{{refund_amount}}" data-field="refund_amount" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">回补库存</view>
        <switch checked="{{restock}}" bindchange="onRestock" disabled="{{!shipped || isDropship}}" />
      </view>
      <view class="field" wx:if="{{restock}}">
        <view class="field-label">退回仓库</view>
        <picker class="field-picker" mode="selector" range="{{warehouseNames}}" value="{{warehouseIndex}}" bindchange="onWarehouse">
          <view>{{warehouseNames[warehouseIndex] || '默认仓库'}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">售后原因</view>
        <input class="field-input" placeholder="如尺码不符、质量问题" value="{{reason}}" data-field="reason" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <input class="field-input" placeholder="选填" value="{{note}}" data-field="note" bindinput="onField" />
      </view>
      <view class="divider"></view>
      <view class="row-between small muted">
        <text>本次预计退货成本 ¥{{returnCostText}}</text>
        <text>{{restock ? '处理后退回库存' : '处理时计入损耗'}}</text>
      </view>
    </view>

    <view class="footer-placeholder"></view>
    <view class="footer-bar">
      <button class="btn btn-primary btn-block" bindtap="onSave">保存售后单</button>
    </view>
  </block>

  <block wx:elif="{{record}}">
    <view class="card">
      <view class="row-between">
        <text class="tag">{{record.no}}</text>
        <text class="tag {{record.status === '已完成' ? 'tag-primary' : (record.status === '待处理' ? 'tag-warn' : 'tag')}}">{{record.status}}</text>
      </view>
      <view class="card-title" style="margin-top: 16rpx;">{{record.type}} · ¥{{record.refund_text}}</view>
      <view class="small muted" style="margin-top: 6rpx;">{{record.date_text}}<text wx:if="{{record.completed_text}}"> · 处理 {{record.completed_text}}</text></view>
      <view class="divider"></view>
      <view class="list-item" data-id="{{order._id}}" bindtap="goOrder">
        <view>
          <view class="muted">关联订单</view>
          <view>{{record.order_no}}{{record.fulfill_mode === '代发' ? ' · 代发' : ''}}</view>
        </view>
        <text class="link small">查看订单 ›</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">售后商品</view>
      <view class="divider"></view>
      <view wx:for="{{items}}" wx:key="product_id" class="list-item">
        <view class="grow">
          <view class="bold">{{item.product_name}}</view>
          <view class="small muted">{{item.sku_code}} · ¥{{item.price_text}} × {{item.qty}}</view>
        </view>
        <text class="bold">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">处理信息</view>
      <view class="divider"></view>
      <view class="list-item"><text class="muted">退款金额</text><text>¥{{refundText}}</text></view>
      <view class="list-item"><text class="muted">库存处理</text><text>{{record.restock ? '退货入库' : '不回补库存'}}</text></view>
      <view class="list-item" wx:if="{{showCost}}"><text class="muted">退货成本</text><text>¥{{returnCostText}}</text></view>
      <view class="list-item" wx:if="{{showCost}}"><text class="muted">计入损耗</text><text>¥{{lossText}}</text></view>
      <view class="list-item"><text class="muted">售后原因</text><text>{{record.reason || '-'}}</text></view>
      <view class="list-item"><text class="muted">备注</text><text>{{record.note || '-'}}</text></view>
      <view class="list-item" wx:if="{{record.reject_reason}}"><text class="muted">拒绝原因</text><text>{{record.reject_reason}}</text></view>
    </view>

    <view class="footer-placeholder"></view>
    <view class="footer-bar" wx:if="{{canUpdate || canDelete}}">
      <button wx:if="{{canDelete}}" class="btn btn-danger grow" bindtap="onDelete">删除</button>
      <button wx:if="{{canUpdate}}" class="btn btn-ghost grow" bindtap="onReject">拒绝</button>
      <button wx:if="{{canUpdate}}" class="btn btn-primary grow" bindtap="onComplete">完成售后</button>
    </view>
  </block>
</view>
