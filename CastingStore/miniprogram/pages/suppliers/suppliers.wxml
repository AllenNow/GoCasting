<view class="page">
  <help-bubble topic="suppliers.list" />
  <view class="card">
    <view class="row" style="gap: 12rpx;">
      <input class="grow" placeholder="搜索名称 / 联系人 / 电话" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="doSearch" />
      <button class="btn btn-sm" bindtap="doSearch">搜索</button>
      <button class="btn btn-primary btn-sm" bindtap="goNew">新增</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无供应商</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goEdit">
    <view class="row-between">
      <view class="bold">{{item.name}}</view>
      <text class="tag tag-primary">{{item.type || '其他'}}</text>
    </view>
    <view class="small muted" style="margin-top: 8rpx;">
      {{item.contact || '未填联系人'}} {{item.phone || ''}}
    </view>
    <view class="row-between" style="margin-top: 8rpx;">
      <text class="small muted">结算：{{item.settlement || '现结'}}</text>
      <text class="small muted">到货约 {{item.lead_time_days || 0}} 天</text>
    </view>
  </view>
</view>
