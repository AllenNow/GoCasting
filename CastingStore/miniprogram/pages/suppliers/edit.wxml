<view class="page">
  <help-bubble topic="suppliers.edit" />
  <view class="card">
    <help-bubble inline topic="suppliers.edit" label="字段说明" />
    <view class="field">
      <view class="field-label">名称</view>
      <input class="field-input" placeholder="如：XX渔具厂" value="{{name}}" data-field="name" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">类型</view>
      <picker class="field-picker" mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onType">
        <view>{{types[typeIndex]}} ▾</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">联系人</view>
      <input class="field-input" placeholder="选填" value="{{contact}}" data-field="contact" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">电话</view>
      <input class="field-input" type="number" placeholder="选填" value="{{phone}}" data-field="phone" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">结算方式</view>
      <picker class="field-picker" mode="selector" range="{{settlements}}" value="{{settlementIndex}}" bindchange="onSettlement">
        <view>{{settlements[settlementIndex]}} ▾</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">到货天数</view>
      <input class="field-input" type="number" placeholder="平均几天到货" value="{{lead_time_days}}" data-field="lead_time_days" bindinput="onField" />
    </view>
    <view class="field">
      <view class="field-label">备注</view>
      <input class="field-input" placeholder="选填" value="{{note}}" data-field="note" bindinput="onField" />
    </view>
  </view>

  <view class="footer-placeholder"></view>
  <view class="footer-bar">
    <button wx:if="{{id && canDelete}}" class="btn btn-danger" bindtap="onDelete">删除</button>
    <button class="btn btn-primary grow" bindtap="onSave" loading="{{saving}}">保存</button>
  </view>
</view>
