<view class="page">
  <help-bubble topic="dismantle.edit" />
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{isView && dismantle}}">
    <view class="card">
      <view class="row-between">
        <view class="grow">
          <view class="card-title">{{dismantle.source_product_name}}</view>
          <view class="card-sub">{{dismantle.no}} · {{dateText}}</view>
        </view>
        <text class="tag tag-primary">{{dismantle.status}}</text>
      </view>
      <view class="divider"></view>
      <view class="list-item">
        <view>拆解数量</view>
        <view class="bold">{{dismantle.qty}}</view>
      </view>
      <view class="list-item">
        <view>拆解人工</view>
        <view class="bold">¥{{dismantle.labor_cost}}</view>
      </view>
      <view class="list-item">
        <view>总成本（旧竿 + 人工）</view>
        <view class="bold">¥{{totalCostText}}</view>
      </view>
      <view class="list-item">
        <view>损耗金额</view>
        <view class="bold">¥{{lossText}}</view>
      </view>
      <help-bubble inline topic="dismantle.loss" label="损耗怎么算" />
    </view>

    <view class="card">
      <view class="card-title">零件产出</view>
      <view class="divider"></view>
      <view class="list-item" wx:for="{{viewItems}}" wx:key="product_id">
        <view>
          <view>{{item.product_name}}</view>
          <view class="small muted">良品 {{item.qty_good}} · 瑕疵 {{item.qty_defect}} · 标准 {{item.std_qty}}</view>
          <view class="small muted" wx:if="{{item.defect_product_name}}">瑕疵 SKU：{{item.defect_product_name}}</view>
          <view class="small muted" wx:if="{{item.loss_qty > 0}}">损耗 {{item.loss_qty}} 件</view>
        </view>
        <view class="bold">¥{{item.good_text}}</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{sourceProduct}}">
    <view class="card">
      <view class="card-title">{{sourceProduct.name}}</view>
      <view class="card-sub">{{sourceProduct.sku_code || '无编码'}} · 状况 {{sourceProduct.condition || '-'}} · 数量 1</view>
      <view class="divider"></view>
      <view class="small muted">先填写标准零件清单（BOM）并可保存；再填写实际良品/瑕疵数量。缺失或报废的数量按 BOM 权重计损耗。</view>
      <help-bubble inline topic="dismantle.bom" label="BOM 与成本分摊" />
    </view>

    <view class="card" wx:for="{{rows}}">
      <view class="row-between">
        <view class="small muted">零件 {{index + 1}}</view>
        <text class="link" data-index="{{index}}" bindtap="onRemoveRow">移除</text>
      </view>
      <view class="field">
        <view class="field-label">零件商品</view>
        <picker class="field-picker" mode="selector" range="{{productNames}}" value="{{item.productIndex}}" data-index="{{index}}" bindchange="onRowProduct">
          <view>{{productNames[item.productIndex] || '请选择零件'}} ▾</view>
        </picker>
      </view>
      <view class="row" style="gap: 12rpx;">
        <view class="field grow">
          <view class="field-label">标准数量</view>
          <input class="field-input" type="digit" value="{{item.std}}" data-index="{{index}}" data-field="std" bindinput="onRowField" />
        </view>
        <view class="field grow">
          <view class="field-label">权重</view>
          <input class="field-input" type="digit" value="{{item.weight}}" data-index="{{index}}" data-field="weight" bindinput="onRowField" />
        </view>
      </view>
      <view class="row" style="gap: 12rpx;">
        <view class="field grow">
          <view class="field-label">良品数量</view>
          <input class="field-input" type="digit" placeholder="0" value="{{item.qty_good}}" data-index="{{index}}" data-field="qty_good" bindinput="onRowField" />
        </view>
        <view class="field grow">
          <view class="field-label">瑕疵数量</view>
          <input class="field-input" type="digit" placeholder="0" value="{{item.qty_defect}}" data-index="{{index}}" data-field="qty_defect" bindinput="onRowField" />
        </view>
      </view>
      <view class="field" wx:if="{{item.qty_defect > 0}}">
        <view class="field-label">瑕疵件 SKU</view>
        <picker class="field-picker" mode="selector" range="{{defectNames}}" value="{{item.defectIndex}}" data-index="{{index}}" bindchange="onRowDefect">
          <view>{{defectNames[item.defectIndex]}} ▾</view>
        </picker>
      </view>
    </view>

    <view class="card">
      <help-bubble inline topic="dismantle.flow" label="拆解流转说明" />
      <button class="btn btn-ghost btn-block" bindtap="onAddRow">新增零件行</button>
      <button class="btn btn-ghost btn-block" style="margin-top: 12rpx;" bindtap="onSaveBom">保存为标准 BOM</button>
      <view class="field" style="margin-top: 16rpx;">
        <view class="field-label">拆解人工成本</view>
        <input class="field-input" type="digit" placeholder="选填，计入拆解总成本" value="{{laborCost}}" bindinput="onLabor" />
      </view>
      <button class="btn btn-primary btn-block" loading="{{saving}}" disabled="{{saving}}" bindtap="onSubmit">执行拆解</button>
    </view>
  </block>
</view>
