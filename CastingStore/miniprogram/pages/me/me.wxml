<view class="page">
  <help-bubble topic="me" />
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="hero">
      <view class="hero-sub">当前账号</view>
      <view class="hero-total">{{hasUser ? userName : '未授权'}}</view>
      <view class="hero-row">
        <view>
          <view class="hero-sub">角色</view>
          <view class="hero-sub bold">{{hasUser ? roleLabel : '--'}}</view>
        </view>
        <view>
          <view class="hero-sub">数据权限</view>
          <view class="hero-sub bold">{{hasUser ? permissionText : '--'}}</view>
        </view>
      </view>
    </view>

    <help-bubble inline topic="me.roles" label="角色权限说明" />

    <view wx:if="{{needInit}}" class="card">
      <view class="card-title">系统尚未初始化</view>
      <view class="card-sub">创建集合、默认仓库，并把当前微信号设为老板。</view>
      <view class="divider"></view>
      <button class="btn btn-primary btn-block" bindtap="onInit">初始化系统</button>
    </view>

    <view wx:if="{{!hasUser && !needInit}}" class="card">
      <view class="card-title">等待分配角色</view>
      <view class="card-sub">把你的 openid 发给老板，分配角色后重新进入小程序。</view>
      <view class="divider"></view>
      <view class="bold" style="word-break: break-all;">{{openid}}</view>
      <view class="divider"></view>
      <button class="btn btn-primary btn-block" bindtap="onCopyOpenid">复制 openid</button>
    </view>

    <view class="card" wx:if="{{hasUser}}">
      <view class="list-item" bindtap="goOrders">
        <text>订单管理</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goInventory">
        <text>商品与库存</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goPurchase">
        <text>采购单</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goAfterSales">
        <text>售后单</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goRepairs">
        <text>维修记录</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goTradeIns">
        <text>旧竿回收</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goSuppliers">
        <text>供应商</text><text class="muted">›</text>
      </view>
      <view class="list-item" bindtap="goReports">
        <text>报表</text><text class="muted">›</text>
      </view>
      <view class="list-item" wx:if="{{canCash}}" bindtap="goCash">
        <text>现金流</text><text class="muted">›</text>
      </view>
      <view class="list-item" wx:if="{{showUsers}}" bindtap="goUsers">
        <text>用户与权限</text><text class="muted">›</text>
      </view>
      <view class="list-item" wx:if="{{showAudit}}" bindtap="goAudit">
        <text>审计日志</text><text class="muted">›</text>
      </view>
    </view>

    <view class="card" wx:if="{{canWarehouse}}">
      <view class="row-between">
        <view class="card-title">仓库</view>
        <button class="btn btn-sm" bindtap="onAddWarehouse">新增</button>
      </view>
      <view class="divider"></view>
      <help-bubble inline topic="me.warehouse" label="仓库规则" />
      <view wx:for="{{warehouses}}" wx:key="_id" class="list-item">
        <view class="row" style="gap: 8rpx;">
          <text>{{item.name}}</text>
          <text wx:if="{{item.is_default}}" class="tag tag-primary">默认</text>
        </view>
        <view class="row" style="gap: 16rpx;">
          <text
            wx:if="{{!item.is_default}}"
            class="tiny link"
            data-id="{{item._id}}"
            catchtap="onDefaultWarehouse"
          >设为默认</text>
          <text
            class="tiny"
            style="color: #d93026;"
            data-id="{{item._id}}"
            catchtap="onDeleteWarehouse"
          >删除</text>
        </view>
      </view>
      <view wx:if="{{warehouses.length === 0}}" class="small muted">暂无仓库，请先新增</view>
    </view>

    <view class="card">
      <view class="list-item" bindtap="onClear">
        <text>清除本地缓存</text><text class="muted">›</text>
      </view>
    </view>
  </block>
</view>
