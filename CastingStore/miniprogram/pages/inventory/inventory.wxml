<view class="page">
  <view class="card">
    <view class="row-between">
      <view>
        <view class="kpi-label">库存总值（按平均成本）</view>
        <view class="card-title" wx:if="{{showCost}}">¥{{totalValue}}</view>
        <view class="card-title" wx:else>{{totalSkus}} 个 SKU</view>
        <view class="small muted">共 {{totalSkus}} 个 SKU，缺货 {{lowStockCount}} 个</view>
      </view>
      <view class="row" style="gap: 12rpx;">
        <button class="btn btn-sm" bindtap="onScan">扫码</button>
        <button wx:if="{{canAdjust}}" class="btn btn-ghost btn-sm" bindtap="goStocktakes">盘点</button>
        <button wx:if="{{canStockin}}" class="btn btn-primary btn-sm" bindtap="goStockin">入库</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="row" style="gap: 12rpx;">
      <input
        class="grow"
        placeholder="搜索商品名 / 编码"
        value="{{keyword}}"
        bindinput="onKeyword"
        confirm-type="search"
        bindconfirm="doSearch"
      />
      <button class="btn btn-sm" bindtap="doSearch">搜索</button>
      <button wx:if="{{canCreate}}" class="btn btn-ghost btn-sm" bindtap="goNewProduct">新增</button>
    </view>
  </view>

  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view class="chip {{filter === 'all' ? 'chip-active' : ''}}" data-filter="all" bindtap="onFilter">全部</view>
    <view class="chip {{filter === 'in' ? 'chip-active' : ''}}" data-filter="in" bindtap="onFilter">有库存</view>
    <view class="chip {{filter === 'low' ? 'chip-active' : ''}}" data-filter="low" bindtap="onFilter">缺货预警</view>
    <view class="chip {{filter === 'value' ? 'chip-active' : ''}}" data-filter="value" bindtap="onFilter">按库存额</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无商品，先新增一个商品吧</view>

  <view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
    <view class="row-between">
      <view class="grow">
        <view class="row" style="gap: 10rpx;">
          <text class="bold">{{item.name}}</text>
          <text class="tag" wx:if="{{item.category}}">{{item.category}}</text>
          <text class="tag {{item.condition === '磕碰' || item.condition === '故障' ? 'tag-danger' : 'tag-primary'}}" wx:if="{{item.condition}}">{{item.condition}}</text>
        </view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.sku_code}}<text wx:if="{{item.spec}}"> · {{item.spec}}</text></view>
      </view>
      <view style="text-align: right;">
        <view class="bold {{item.empty ? 'muted' : ''}}">{{item.qty_text}} {{item.unit || '件'}}</view>
        <view class="small muted" wx:if="{{item.repairing}}">维修中 {{item.repairing_text}}</view>
        <view class="small muted">安全库存 {{item.safety_text}}</view>
      </view>
    </view>
    <view class="row-between" style="margin-top: 14rpx;">
      <text class="tag {{item.low ? 'tag-danger' : 'tag-primary'}}">{{item.low ? '缺货预警' : '库存正常'}}</text>
      <text class="small muted" wx:if="{{showCost}}">库存额 ¥{{item.value_text}}</text>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>
