<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:elif="{{needInit}}">
    <view class="card">
      <view class="card-title">系统尚未初始化</view>
      <view class="card-sub">首次使用会创建数据库集合、默认仓库，并把当前微信号设为老板。</view>
      <view class="divider"></view>
      <button class="btn btn-primary btn-block" bindtap="onInit">初始化系统</button>
    </view>
  </block>

  <block wx:elif="{{!hasUser}}">
    <view class="card">
      <view class="card-title">账号未授权</view>
      <view class="card-sub">请把下面的 openid 发给老板，让他为你分配角色后重新打开小程序。</view>
      <view class="divider"></view>
      <view class="small muted">我的 openid</view>
      <view class="bold" style="word-break: break-all; margin-top: 8rpx;">{{openid}}</view>
      <view class="divider"></view>
      <button class="btn btn-primary btn-block" bindtap="onCopyOpenid">复制 openid</button>
    </view>
  </block>

  <block wx:else>
    <view class="hero">
      <view class="kpi-label">本月实收（唯一收入口径）</view>
      <view class="hero-total">¥{{monthSales}}</view>
      <view class="hero-row">
        <view>
          <view class="hero-sub">本月毛利</view>
          <view class="hero-sub bold" wx:if="{{showCost}}">¥{{monthProfit}}</view>
          <view class="hero-sub bold" wx:else>按角色隐藏</view>
        </view>
        <view>
          <view class="hero-sub">毛利率</view>
          <view class="hero-sub bold" wx:if="{{showCost}}">{{monthProfitRate}}</view>
          <view class="hero-sub bold" wx:else>--</view>
        </view>
        <view>
          <view class="hero-sub">今日订单</view>
          <view class="hero-sub bold">{{todayOrders}} 单</view>
        </view>
      </view>
    </view>

    <view class="grid-2">
      <view class="kpi">
        <view class="kpi-label">今日实收</view>
        <view class="kpi-value">¥{{todaySales}}</view>
      </view>
      <view class="kpi" wx:if="{{canCash}}">
        <view class="kpi-label">现金余额</view>
        <view class="kpi-value" wx:if="{{cashBalance !== ''}}">¥{{cashBalance}}</view>
        <view class="kpi-value" wx:else>未设置</view>
      </view>
      <view class="kpi">
        <view class="kpi-label">库存总值</view>
        <view class="kpi-value" wx:if="{{showCost}}">¥{{stockValue}}</view>
        <view class="kpi-value" wx:else>{{stockSkus}} SKU</view>
      </view>
      <view class="kpi">
        <view class="kpi-label">在售 SKU</view>
        <view class="kpi-value">{{stockSkus}}</view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <view class="card-title">今日待办</view>
        <view class="small muted">{{userName}} · {{roleLabel}}</view>
      </view>
      <view class="divider"></view>
      <view class="list-item" bindtap="goOrders">
        <view>
          <view>待发货订单</view>
          <view class="small muted">发货后自动扣减库存并锁定成本</view>
        </view>
        <view class="row">
          <text class="tag {{pendingShip > 0 ? 'tag-warn' : 'tag-primary'}}">{{pendingShip}} 单</text>
        </view>
      </view>
      <view class="list-item" bindtap="goInventory">
        <view>
          <view>缺货预警</view>
          <view class="small muted">可用库存低于安全库存</view>
        </view>
        <text class="tag {{lowStock > 0 ? 'tag-danger' : 'tag-primary'}}">{{lowStock}} 个 SKU</text>
      </view>
      <view class="list-item" bindtap="goReports">
        <view>
          <view>滞销 90 天</view>
          <view class="small muted">有库存但 90 天无销售</view>
        </view>
        <text class="tag {{slowMoving > 0 ? 'tag-warn' : 'tag-primary'}}">{{slowMoving}} 个 SKU</text>
      </view>
      <view class="list-item" bindtap="goPurchase">
        <view>
          <view>待付款采购单</view>
          <view class="small muted">已入库或已下单但未付清</view>
        </view>
        <text class="tag {{unpaidPurchase > 0 ? 'tag-danger' : 'tag-primary'}}">{{unpaidPurchase}} 单</text>
      </view>
      <view class="list-item" bindtap="goAfterSales">
        <view>
          <view>待处理售后</view>
          <view class="small muted">退货退款待确认，处理后回补库存或计损耗</view>
        </view>
        <text class="tag {{pendingAfterSale > 0 ? 'tag-warn' : 'tag-primary'}}">{{pendingAfterSale}} 单</text>
      </view>
      <view class="list-item" bindtap="goStocktakes">
        <view>
          <view>本月盘点</view>
          <view class="small muted">每月至少完成一次盘点，差异自动记盘盈/盘亏</view>
        </view>
        <text class="tag {{monthStocktakeDone ? 'tag-primary' : 'tag-warn'}}">{{monthStocktakeDone ? '已盘点' : (monthStocktakeCount > 0 ? '进行中' : '待盘点')}}</text>
      </view>
      <view class="list-item" bindtap="goOrders">
        <view>
          <view>代发待结算</view>
          <view class="small muted">代发订单尚未结清供应商货款</view>
        </view>
        <text class="tag {{dropshipUnsettled > 0 ? 'tag-warn' : 'tag-primary'}}">{{dropshipUnsettled}} 单</text>
      </view>
      <view class="list-item" bindtap="goReports">
        <view>
          <view>本月待对账平台</view>
          <view class="small muted">本月有销售但还没做平台对账</view>
        </view>
        <text class="tag {{pendingSettlement > 0 ? 'tag-warn' : 'tag-primary'}}">{{pendingSettlement}} 个</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">快捷操作</view>
      <view class="divider"></view>
      <view class="grid-2">
        <button class="btn btn-primary btn-block" bindtap="goNewOrder">新建订单</button>
        <button class="btn btn-primary btn-block" bindtap="goStockin">扫码入库</button>
        <button class="btn btn-ghost btn-block" bindtap="goNewPurchase">新建采购单</button>
        <button class="btn btn-ghost btn-block" bindtap="goAfterSales">售后单</button>
        <button class="btn btn-ghost btn-block" bindtap="goProducts">商品与库存</button>
        <button class="btn btn-ghost btn-block" wx:if="{{canCash}}" bindtap="goCash">现金流</button>
      </view>
    </view>
  </block>
</view>
