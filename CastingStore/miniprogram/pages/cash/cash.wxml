<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!allowed}}" class="empty">当前角色没有查看现金流的权限</view>

  <block wx:else>
    <view class="hero">
      <view class="kpi-label">现金总额</view>
      <view class="hero-total">¥{{total}}</view>
      <view class="hero-row">
        <view>
          <view class="hero-sub">本月收入</view>
          <view class="hero-sub bold">¥{{income}}</view>
        </view>
        <view>
          <view class="hero-sub">本月支出</view>
          <view class="hero-sub bold">¥{{expense}}</view>
        </view>
        <view>
          <view class="hero-sub">净流入</view>
          <view class="hero-sub bold">¥{{net}}</view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{canCreate}}">
      <view class="card-title">记一笔</view>
      <view class="row" style="gap: 12rpx; margin-top: 16rpx;">
        <view
          wx:for="{{types}}"
          wx:key="*this"
          class="chip {{typeIndex === index ? 'chip-active' : ''}}"
          data-index="{{index}}"
          bindtap="onType"
        >{{item}}</view>
      </view>
      <view class="divider"></view>
      <view class="field">
        <view class="field-label">金额</view>
        <input class="field-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" />
      </view>
      <view class="field">
        <view class="field-label">分类</view>
        <picker class="field-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
          <view>{{categories[categoryIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">账户</view>
        <picker class="field-picker" mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="onAccount">
          <view>{{accountNames[accountIndex] || '请先新增账户'}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">日期</view>
        <picker class="field-picker" mode="date" value="{{date}}" bindchange="onDate">
          <view>{{date}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <input class="field-input" placeholder="选填" value="{{note}}" bindinput="onNote" />
      </view>
      <button class="btn btn-primary btn-block" style="margin-top: 20rpx;" bindtap="onSaveTxn" loading="{{saving}}">保存</button>
    </view>

    <view class="card">
      <view class="row-between">
        <view class="card-title">资金账户</view>
        <button wx:if="{{canCreate}}" class="btn btn-sm" bindtap="onAddAccount">新增账户</button>
      </view>
      <view class="divider"></view>
      <view wx:if="{{accounts.length === 0}}" class="empty" style="padding: 24rpx 0;">还没有资金账户，先新增一个</view>
      <view wx:for="{{accounts}}" wx:key="_id" class="list-item">
        <view>
          <view class="row" style="gap: 8rpx;">
            <text class="bold">{{item.name}}</text>
            <text wx:if="{{item.is_default}}" class="tag tag-primary">默认</text>
          </view>
          <view class="tiny muted">期初 ¥{{item.initial_text}} · {{item.txn_count}} 笔流水</view>
        </view>
        <view style="text-align: right;">
          <view class="bold">¥{{item.balance_text}}</view>
          <view class="row" style="gap: 16rpx; justify-content: flex-end;">
            <text
              wx:if="{{canUpdate && !item.is_default}}"
              class="tiny link"
              data-id="{{item._id}}"
              catchtap="onDefaultAccount"
            >设为默认</text>
            <text
              wx:if="{{canDelete}}"
              class="tiny"
              style="color: #d93026;"
              data-id="{{item._id}}"
              catchtap="onDeleteAccount"
            >删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <view class="card-title">收支流水</view>
        <picker mode="date" fields="month" value="{{month}}" bindchange="onMonth">
          <view class="small link">{{month}} ▾</view>
        </picker>
      </view>
      <view class="divider"></view>
      <view wx:if="{{txns.length === 0}}" class="empty" style="padding: 24rpx 0;">本月没有流水</view>
      <view wx:for="{{txns}}" wx:key="_id" class="list-item">
        <view>
          <view class="row" style="gap: 8rpx;">
            <text class="bold">{{item.category || '其他'}}</text>
            <text wx:if="{{item.source}}" class="tag tag-primary">自动</text>
          </view>
          <view class="tiny muted">{{item.account_name}} · {{item.date_text}}</view>
          <view wx:if="{{item.note}}" class="tiny muted">{{item.note}}</view>
        </view>
        <view style="text-align: right;">
          <view class="bold" style="color: {{item.income ? '#0f766e' : '#d93026'}};">
            {{item.income ? '+' : '-'}}¥{{item.amount_text}}
          </view>
          <text wx:if="{{canDelete && !item.source}}" class="tiny" style="color: #d93026;" data-id="{{item._id}}" catchtap="onDeleteTxn">删除</text>
        </view>
      </view>
    </view>

    <view class="footer-placeholder"></view>
  </block>
</view>
