<view class="page">
  <help-bubble topic="products.edit" />
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="card">
      <view class="card-title">基础信息</view>
      <view class="divider"></view>
      <view class="field">
        <view class="field-label">名称</view>
        <input class="field-input" placeholder="如：碳素路亚竿 2.1m" value="{{name}}" data-field="name" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">内部编码</view>
        <input class="field-input" placeholder="留空自动生成" value="{{sku_code}}" data-field="sku_code" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">品类</view>
        <picker class="field-picker" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
          <view>{{categories[categoryIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">品牌</view>
        <picker class="field-picker" mode="selector" range="{{brandOptions}}" value="{{brandIndex}}" bindchange="onBrand">
          <view>{{brand || (brandOther ? '其他' : '请选择')}} ▾</view>
        </picker>
      </view>
      <view class="field" wx:if="{{brandOther}}">
        <view class="field-label">自定义品牌</view>
        <input class="field-input" placeholder="请输入品牌名称" value="{{brandCustom}}" bindinput="onBrandInput" />
      </view>
      <view class="field">
        <view class="field-label">商品类型</view>
        <picker class="field-picker" mode="selector" range="{{itemTypes}}" value="{{itemTypeIndex}}" bindchange="onItemType">
          <view>{{itemTypes[itemTypeIndex]}} ▾</view>
        </picker>
      </view>
      <help-bubble inline topic="product.type" label="类型说明" />
      <view class="field">
        <view class="field-label">商品状况</view>
        <picker class="field-picker" mode="selector" range="{{conditionOptions}}" value="{{conditionIndex}}" bindchange="onCondition">
          <view>{{condition || '请选择'}} ▾</view>
        </picker>
      </view>
      <help-bubble inline topic="product.condition" label="状况说明" />
      <view class="field">
        <view class="field-label">规格</view>
        <input class="field-input" placeholder="如：M/ML、5号" value="{{spec}}" data-field="spec" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">单位</view>
        <input class="field-input" placeholder="件 / 个 / 盘" value="{{unit}}" data-field="unit" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">条码</view>
        <input class="field-input" placeholder="用于扫码入库" value="{{barcode}}" data-field="barcode" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">安全库存</view>
        <input class="field-input" type="number" placeholder="低于该值预警" value="{{safety_stock}}" data-field="safety_stock" bindinput="onField" />
      </view>
      <view class="field">
        <view class="field-label">状态</view>
        <picker class="field-picker" mode="selector" range="{{statusList}}" value="{{statusIndex}}" bindchange="onStatus">
          <view>{{statusList[statusIndex]}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">默认供应商</view>
        <picker class="field-picker" mode="selector" range="{{supplierNames}}" value="{{supplierIndex}}" bindchange="onSupplier">
          <view>{{supplierNames[supplierIndex] || '未指定'}} ▾</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <input class="field-input" placeholder="选填" value="{{note}}" data-field="note" bindinput="onField" />
      </view>
    </view>

    <view class="card">
      <button class="btn btn-ghost btn-block" bindtap="onScan">扫描条码</button>
    </view>

    <view class="footer-placeholder"></view>
    <view class="footer-bar">
      <button wx:if="{{id && canDelete}}" class="btn btn-danger grow" bindtap="onDelete">删除</button>
      <button class="btn btn-primary grow" bindtap="onSave" loading="{{saving}}">保存</button>
    </view>
  </block>
</view>
