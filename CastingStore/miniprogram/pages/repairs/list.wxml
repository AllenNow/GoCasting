<view class="page">
  <help-bubble topic="repairs.list" />
  <scroll-view scroll-x class="scroll-x" style="margin-bottom: 16rpx;">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="chip {{activeTab === item ? 'chip-active' : ''}}"
      data-tab="{{item}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <help-bubble inline topic="repair.flow" label="维修流转说明" />

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无维修记录</view>

  <view
    wx:for="{{list}}"
    wx:key="_id"
    class="card"
    data-id="{{item._id}}"
    bindtap="onDetail"
  >
    <view class="row-between">
      <view class="grow">
        <view class="row" style="gap: 10rpx;">
          <text class="bold">{{item.product_name}}</text>
          <text class="tag {{item.tag_class}}">{{item.status}}</text>
        </view>
        <view class="small muted" style="margin-top: 4rpx;">{{item.no}} · {{item.date_text}}</view>
      </view>
      <view style="text-align: right;">
        <view class="bold">{{item.qty_text}} 件</view>
        <view class="small muted">费用 ¥{{item.cost_text}}</view>
      </view>
    </view>
    <view class="small muted" style="margin-top: 10rpx;">
      {{item.warehouse_name}} · 渠道 {{item.repair_channel}} · 方式 {{item.repair_method}}
    </view>
    <view class="small muted" wx:if="{{item.note}}">备注：{{item.note}}</view>
    <view class="small muted" wx:if="{{item.completed_text}}">完成时间 {{item.completed_text}}</view>
    <view class="row" style="gap: 12rpx; margin-top: 14rpx;" wx:if="{{item.pending && canUpdate}}">
      <button class="btn btn-primary btn-sm grow" data-id="{{item._id}}" catchtap="onComplete">完成维修</button>
      <button class="btn btn-ghost btn-sm grow" data-id="{{item._id}}" catchtap="onCancel">取消维修</button>
    </view>
  </view>

  <view class="footer-placeholder"></view>
</view>
