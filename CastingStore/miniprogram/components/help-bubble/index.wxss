/* 帮助组件：悬浮按钮 / 内联胶囊 / 底部气泡面板 */

/* ---------- 悬浮按钮 ---------- */
.hb-fab {
  position: fixed;
  right: 28rpx;
  z-index: 900;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #0f766e;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(15, 118, 110, 0.35);
}

/* ---------- 内联胶囊 ---------- */
.hb-inline {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx 4rpx 16rpx;
  margin: 10rpx 0 0;
  border-radius: 999rpx;
  background: #e6f4f1;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 1.4;
}

.hb-inline-label {
  color: #0f766e;
}

.hb-inline-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2rpx solid #0f766e;
  color: #0f766e;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 遮罩 ---------- */
.hb-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.48);
  display: flex;
  align-items: flex-end;
  animation: hb-fade 0.16s ease-out;
}

/* ---------- 面板 ---------- */
.hb-panel {
  width: 100%;
  max-height: 86vh;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: hb-slide-up 0.22s ease-out;
}

.hb-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hb-head-main {
  flex: 1;
  min-width: 0;
}

.hb-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.hb-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.hb-close {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f2f4f7;
  color: #6b7280;
  font-size: 36rpx;
  line-height: 52rpx;
  text-align: center;
}

.hb-roles {
  margin-top: 16rpx;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: #f0f9f7;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 1.5;
}

/* ---------- 内容区 ---------- */
.hb-body {
  flex: 1;
  min-height: 0;
  height: 54vh;
  margin-top: 18rpx;
}

.hb-sec {
  padding-bottom: 22rpx;
  margin-bottom: 22rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.hb-sec:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.hb-sec-title {
  display: flex;
  align-items: center;
  font-size: 27rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.hb-sec-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
  background: #0f766e;
}

.hb-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hb-line {
  display: flex;
  align-items: flex-start;
  font-size: 25rpx;
  color: #374151;
  line-height: 1.62;
}

.hb-bullet {
  flex-shrink: 0;
  width: 20rpx;
  color: #0f766e;
  font-weight: 700;
}

.hb-line-text {
  flex: 1;
  min-width: 0;
}

/* ---------- 流转步骤 ---------- */
.hb-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f7faf9;
}

.hb-step {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #d7ece8;
  color: #0f766e;
  font-size: 22rpx;
  line-height: 1.3;
}

.hb-arrow {
  color: #9aa1ab;
  font-size: 22rpx;
  line-height: 1;
}

/* ---------- 字段说明 ---------- */
.hb-fields {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hb-field {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f8f9fb;
}

.hb-field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.hb-field-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* ---------- 注意事项 ---------- */
.hb-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff8ed;
  border-left: 6rpx solid #f59e0b;
}

.hb-tip-mark {
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #f59e0b;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
}

.hb-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #92400e;
  line-height: 1.6;
}

/* ---------- 底部按钮 ---------- */
.hb-foot {
  padding-top: 16rpx;
}

.hb-btn {
  height: 84rpx;
  border-radius: 16rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
}

@keyframes hb-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes hb-slide-up {
  from {
    transform: translateY(40rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
