/* components/privacy-popup/index.wxss */

.pp-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  animation: pp-fade 0.2s ease-out;
}

.pp-dialog {
  width: 600rpx;
  padding: 40rpx 36rpx 30rpx;
  background: #ffffff;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  animation: pp-pop 0.24s ease-out;
}

@keyframes pp-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pp-pop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.pp-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 44rpx;
  border-radius: 50%;
  background: #e6f4ef;
  margin-bottom: 20rpx;
}

.pp-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.pp-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #666666;
  text-align: left;
}

.pp-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 20rpx 0 28rpx;
}

.pp-link {
  font-size: 24rpx;
  color: #1a7f5a;
  padding: 4rpx;
}

.pp-link-sep {
  font-size: 24rpx;
  color: #cccccc;
}

.pp-actions {
  display: flex;
  width: 100%;
  gap: 20rpx;
}

.pp-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.pp-btn-ghost {
  color: #666666;
  background: #f4f6f4;
}

.pp-btn-primary {
  flex: 1.4;
  color: #ffffff;
  background: #1a7f5a;
  border: none;
  padding: 0;
  margin: 0;
}

.pp-btn-primary::after {
  border: none;
}

.pp-footnote {
  margin-top: 20rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #999999;
  text-align: center;
}
