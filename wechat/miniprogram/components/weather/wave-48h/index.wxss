/* 48 小时浪况趋势 */
:host { display: block; }

.wave-legend {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.wl-item { display: flex; align-items: center; gap: 6rpx; }
.wl-dot  {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.wl-dot-wave  { background: #1a7f5a; }
.wl-dot-swell { background: #4a90d9; }
.wl-text { font-size: 22rpx; color: #888; }

.wave-scroll { width: 100%; }
.wave-scroll-inner {
  display: flex;
  align-items: flex-end;
  gap: 0;
  /* 旋转后的时间标签会向上溢出，这里预留空间，避免被 scroll-view 顶部裁切 */
  padding: 20rpx 0 4rpx;
  min-width: max-content;
}
.wave-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 36rpx;
  gap: 4rpx;
}
.wave-col-mark { background: rgba(26,127,90,0.04); border-radius: 6rpx; }

.wave-col-time {
  font-size: 17rpx;
  color: #888;
  white-space: nowrap;
  transform: rotate(-45deg);
  margin-bottom: 2rpx;
  height: 28rpx;
  line-height: 28rpx;
}
.invisible { opacity: 0; }

.wave-bar-group {
  display: flex;
  gap: 4rpx;
  align-items: flex-end;
  height: 92rpx;
  justify-content: center;
}
/* 提高优先级，避免与页面内 day-wave 的 .wave-bar-group 规则冲突 */
.wave-bar-group.wave-bar-group-48h { height: 72rpx; }
.wave-bar {
  width: 12rpx;
  border-radius: 3rpx 3rpx 0 0;
  min-height: 4rpx;
  transition: height 0.4s ease;
}
.wave-bar-wind  { background: #1a7f5a; opacity: 0.85; }
.wave-bar-swell { background: #4a90d9; opacity: 0.65; }

.wave-col-val {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}
.wave-col-sst {
  font-size: 16rpx;
  color: #e85555;
  margin-top: 0;
}

.wave-footer-note { margin-top: 2rpx; }
.wave-note-text { font-size: 18rpx; color: #ccc; }
