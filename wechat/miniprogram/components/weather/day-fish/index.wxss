/* 鱼口模块：建议垂钓时段 + 热力图 */
:host { display: block; }

.day-section-label {
  display: block;
  font-size: 20rpx;
  color: #aaa;
  font-weight: 600;
  margin: 6rpx 0 4rpx;
}
.invisible { opacity: 0; }

/* 最佳垂钓时段 */
.best-windows-wrap {
  margin: 6rpx 0 4rpx;
  background: #f7fbf9;
  border-radius: 18rpx;
  padding: 10rpx 12rpx;
}
.best-windows-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.best-windows-title { font-size: 24rpx; font-weight: 700; color: #1a2a1a; }
.best-windows-hint  { font-size: 18rpx; color: #aaa; }

.window-scroll { width: 100%; }
.window-row {
  display: flex;
  gap: 8rpx;
  min-width: max-content;
  padding-bottom: 2rpx;
}
.window-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 330rpx;
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
}
.window-card:last-child { margin-right: 0; }
.grade-bg-excellent { background: rgba(26,127,90,0.1); }
.grade-bg-good      { background: rgba(45,206,137,0.1); }
.grade-bg-ok        { background: rgba(230,168,23,0.08); }
.grade-bg-poor      { background: rgba(245,166,35,0.08); }
.grade-bg-bad       { background: rgba(232,85,85,0.08); }

.window-card-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.window-emoji { font-size: 26rpx; flex-shrink: 0; }
.window-info  { display: flex; flex-direction: column; gap: 1rpx; }
.window-time  { font-size: 24rpx; font-weight: 700; color: #1a2a1a; line-height: 1.2; }
.window-duration { font-size: 18rpx; color: #888; line-height: 1.2; }

.window-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}
.window-cal {
  font-size: 19rpx;
  color: #2d8a63;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(45, 138, 99, 0.1);
}
.window-score {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  flex-shrink: 0;
}
.window-score-num  { font-size: 30rpx; font-weight: 800; }
.window-score-max  { font-size: 18rpx; color: #aaa; }
.grade-excellent .window-score-num { color: #1a7f5a; }
.grade-good      .window-score-num { color: #2dce89; }
.grade-ok        .window-score-num { color: #e6a817; }
.grade-poor      .window-score-num { color: #f5a623; }
.grade-bad       .window-score-num { color: #e85555; }

/* 无最佳时段提示 */
.no-window-tip {
  background: #fff8e6;
  border-radius: 14rpx;
  padding: 8rpx 12rpx;
  margin: 6rpx 0;
  font-size: 20rpx;
  line-height: 1.3;
  color: #b07800;
}

/* 热力图 */
.fish-heatmap-wrap { margin-top: 4rpx; }
.heatmap-scroll { width: 100%; }
.heatmap-row {
  display: flex;
  align-items: flex-end;
  gap: 0;
  padding-bottom: 4rpx;
  min-width: max-content;
}
.heatmap-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 28rpx;
  gap: 4rpx;
}
.heatmap-bar-wrap {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.heatmap-bar {
  width: 20rpx;
  min-height: 4rpx;
  border-radius: 3rpx 3rpx 0 0;
  transition: height 0.3s;
}
.heatmap-score {
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1;
}
.heatmap-time {
  font-size: 15rpx;
  color: #aaa;
  white-space: nowrap;
  transform: rotate(-45deg);
  height: 28rpx;
  line-height: 28rpx;
}

/* 图例 */
.heatmap-legend {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
  padding: 0 4rpx;
}
.heatmap-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.heatmap-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.heatmap-legend-item text { font-size: 18rpx; color: #888; }
