/* 天光卡（日出日落弧线 + 黄金档） */
:host { display: block; }

.sun-card {
  margin: 14rpx 16rpx 0;
  padding: 16rpx 18rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(165deg, #fffdf7 0%, #fdf3e1 100%);
  border: 1rpx solid rgba(240, 200, 130, 0.4);
  box-shadow: 0 4rpx 20rpx rgba(180, 140, 60, 0.12);
}
.sun-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sun-title-wrap { display: flex; align-items: baseline; gap: 10rpx; }
.sun-title { font-size: 30rpx; font-weight: 700; color: #5a4320; }
.sun-src {
  font-size: 18rpx;
  color: #a98a55;
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.sun-len { font-size: 22rpx; color: #a1804c; }

.sun-arc-wrap { position: relative; height: 132rpx; margin-top: 2rpx; }
.sun-arc {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 36rpx;
  height: 92rpx;
  border-top: 3rpx dashed rgba(240, 170, 70, 0.55);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.sun-horizon {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 36rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(240,170,70,0), rgba(240,170,70,0.55), rgba(240,170,70,0));
}
.sun-dot {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  margin-left: -13rpx;
  border-radius: 50%;
  z-index: 2;
  transition: left 0.6s ease, bottom 0.6s ease;
}
.sun-dot-day {
  background: radial-gradient(circle at 35% 35%, #ffe9a8, #ffb020 70%);
  box-shadow: 0 0 18rpx rgba(255, 170, 40, 0.85);
}
.sun-dot-night {
  background: #c9d4e0;
  box-shadow: 0 0 10rpx rgba(150, 170, 200, 0.6);
  opacity: 0.8;
}
.sun-edge { position: absolute; bottom: 6rpx; font-size: 20rpx; color: #a1804c; }
.sun-edge-left  { left: 0; }
.sun-edge-right { right: 0; }
.sun-status {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8a6c3c;
  margin-top: -2rpx;
}

.golden-row { display: flex; gap: 12rpx; margin-top: 8rpx; }
.golden-chip {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(240, 190, 110, 0.5);
  transition: background 0.2s, box-shadow 0.2s;
}
.golden-chip-active {
  background: #fff2d0;
  border-color: #f0b03a;
  box-shadow: 0 0 0 3rpx rgba(240, 176, 58, 0.25);
}
.golden-icon { font-size: 30rpx; }
.golden-info { display: flex; flex-direction: column; gap: 2rpx; }
.golden-label { font-size: 22rpx; font-weight: 700; color: #6a4d1d; }
.golden-time  { font-size: 20rpx; color: #a1804c; }

.sun-foot {
  display: flex;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed rgba(200, 160, 90, 0.35);
}
.sun-foot-item { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.sun-foot-tap { align-items: flex-end; }
.sun-foot-label { font-size: 20rpx; color: #b39462; }
.sun-foot-val   { font-size: 24rpx; font-weight: 700; color: #5a4320; }
.sun-foot-fish  { color: #c07a1a; }
.sun-foot-more  { font-size: 18rpx; font-weight: 400; color: #b39462; }

.sun-minutely {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(90, 140, 200, 0.1);
}
.sun-minutely-icon { font-size: 22rpx; }
.sun-minutely-text { flex: 1; font-size: 21rpx; color: #4a6a8a; }
.sun-minutely-rain {
  background: rgba(70, 130, 200, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(70, 130, 200, 0.18);
}
