/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #e0e0e0;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-top: 10rpx;
}

.tab-icon {
  font-size: 44rpx;
  line-height: 1;
  filter: grayscale(100%);
  opacity: 0.5;
}

.tab-bar-item--active .tab-icon {
  filter: none;
  opacity: 1;
}

.tab-label {
  font-size: 20rpx;
  color: #999999;
  line-height: 1;
}

.tab-bar-item--active .tab-label {
  color: #1a7f5a;
  font-weight: 600;
}
