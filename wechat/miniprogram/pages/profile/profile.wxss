/* pages/profile/profile.wxss — 个人中心 */

.page-container {
  min-height: 100vh;
  background: #f4f6f4;
}

/* ===== 头部 ===== */
.profile-header {
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 角色标识 */
.role-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.role-badge.super {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
}

.role-badge.super text {
  color: #333;
}

.role-badge text {
  font-size: 22rpx;
  color: #fff;
}

/* 头像 */
.avatar-btn {
  background: none !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  line-height: 1;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  display: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

/* 昵称区域 */
.user-name-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
}

.nickname-input {
  width: auto;
  min-width: 120rpx;
  max-width: 400rpx;
  height: 48rpx;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
}

.nickname-input.has-value {
  color: #fff;
}

.nickname-placeholder {
  color: rgba(255,255,255,0.8);
  font-weight: 600;
}

.edit-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}

/* ===== 菜单 ===== */
.menu-section {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #fff;
  border: none;
  text-align: left;
  line-height: 1;
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item::after {
  display: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 44rpx;
  text-align: center;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}

/* 红点徽章 */
.badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #e53935;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.status-tag.pending {
  background: #fff3e0;
  color: #ef6c00;
}

.status-tag.rejected {
  background: #ffebee;
  color: #c62828;
}

/* ===== 关于 ===== */
.about-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx;
  gap: 8rpx;
}

.about-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.about-desc {
  font-size: 24rpx;
  color: #999;
}

.about-version {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 4rpx;
}

.safe-bottom {
  height: 40rpx;
}
