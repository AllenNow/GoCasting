/* pages/profile/profile.wxss — 个人中心（精简版）*/

.page-container {
  min-height: 100vh;
  background: #f4f6f4;
}

/* ===== 头部 ===== */
.profile-header {
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.user-info,
.user-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar-btn {
  background: none;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  display: none;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.3);
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 16rpx;
}

.user-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.setup-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
}

.nickname-input {
  width: 400rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #fff;
  text-align: center;
  margin-top: 16rpx;
}

.nickname-input::placeholder {
  color: rgba(255,255,255,0.5);
}

.admin-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.admin-badge text {
  font-size: 22rpx;
  color: #fff;
}

/* ===== 菜单 ===== */
.menu-section {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #fff;
  border: none;
  text-align: left;
  line-height: 1;
}

.menu-item::after {
  display: none;
}

.share-btn {
  width: 100%;
  margin: 0;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ===== 关于 ===== */
.about-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 12rpx;
}

.about-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.about-desc {
  font-size: 24rpx;
  color: #999;
}

.about-version {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.safe-bottom {
  height: 40rpx;
}
