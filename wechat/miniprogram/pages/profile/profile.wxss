/* pages/profile/profile.wxss */

/* 用户头部 */
.profile-header {
  background: linear-gradient(135deg, #1a7f5a, #0d5c42);
  padding: 48rpx 32rpx 56rpx;
}

.user-info, .user-unlogged {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.user-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.username {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* 统计卡片 */
.stats-card {
  margin: -28rpx 24rpx 16rpx;
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  padding: 28rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
}

.stat-num-lg {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-label-sm {
  font-size: 20rpx;
  color: var(--color-text-hint);
  margin-top: 4rpx;
  text-align: center;
}

.highlight-row {
  display: flex;
  gap: 16rpx;
}

.highlight-item {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.highlight-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.highlight-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.green { color: var(--color-primary); }

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-more {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 最近列表 */
.recent-list {
  padding: 0 24rpx;
}

.recent-item {
  margin-bottom: 12rpx;
  padding: 20rpx 24rpx;
}

.recent-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.recent-species {
  font-size: 30rpx;
  font-weight: 600;
}

.recent-weight {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.recent-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recent-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.recent-location {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 记录小按钮 */
.record-btn-sm {
  padding: 18rpx 40rpx;
  font-size: 28rpx;
  border-radius: 100rpx;
}

/* 功能菜单 */
.menu-list {
  margin: 0 24rpx 16rpx;
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  background: none;
  border: none;
  width: 100%;
  text-align: left;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 36rpx;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}

.share-btn {
  line-height: normal;
}

/* ===== 成就徽章 ===== */
.section-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.badges-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 0 24rpx 8rpx;
}

.badge-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 8rpx 16rpx;
  box-shadow: var(--shadow-card);
  gap: 6rpx;
}

.badge-locked {
  opacity: 0.4;
  background: var(--color-bg);
  box-shadow: none;
}

.badge-icon {
  font-size: 48rpx;
  line-height: 1;
}

.badge-name {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
}

.badge-desc {
  font-size: 18rpx;
  color: var(--color-text-hint);
  text-align: center;
  line-height: 1.4;
}

/* ===== 图表 ===== */
.chart-card, .species-chart-card {
  margin: 0 24rpx 16rpx;
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.chart-period { font-size: 22rpx; color: var(--color-text-hint); }

/* 月度条形图 */
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 160rpx;
  padding-bottom: 32rpx;
}
.bar-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  position: relative;
}
.bar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  width: 100%;
}
.bar-fill {
  width: 70%;
  background: var(--color-primary);
  border-radius: 4rpx 4rpx 0 0;
  transition: height 0.4s ease;
}
.bar-count {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 4rpx;
}
.bar-label {
  font-size: 20rpx;
  color: var(--color-text-hint);
  position: absolute;
  bottom: 0;
}

/* 鱼种分布 */
.species-bars { display: flex; flex-direction: column; gap: 14rpx; }
.species-row  { display: flex; align-items: center; gap: 12rpx; }
.species-name { font-size: 24rpx; color: var(--color-text-primary); width: 80rpx; flex-shrink: 0; }
.species-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: var(--color-bg);
  border-radius: 100rpx;
  overflow: hidden;
}
.species-bar  { height: 100%; border-radius: 100rpx; transition: width 0.4s ease; }
.species-count{ font-size: 22rpx; color: var(--color-text-hint); width: 32rpx; text-align: right; flex-shrink: 0; }
