<!-- pages/profile/profile.wxml — 个人中心 -->
<view class="page-container">

  <!-- 用户信息头部 -->
  <view class="profile-header">
    <!-- 角色标识 -->
    <view wx:if="{{ role === 'super_admin' }}" class="role-badge super">
      <text>👑 超级管理员</text>
    </view>
    <view wx:elif="{{ role === 'competition_admin' }}" class="role-badge">
      <text>🔑 赛事管理员</text>
    </view>

    <!-- 头像 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{ userInfo && userInfo.avatarUrl }}" class="avatar" src="{{ userInfo.avatarUrl }}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">🎣</view>
    </button>

    <!-- 昵称区域 -->
    <view class="user-name-area">
      <input
        class="nickname-input {{ userInfo && userInfo.nickName ? 'has-value' : '' }}"
        type="nickname"
        value="{{ userInfo.nickName || '' }}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        placeholder="钓鱼爱好者"
        placeholder-class="nickname-placeholder"
      />
      <text class="edit-hint">点击修改昵称</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="card">
      <!-- 超级管理员：权限管理入口 -->
      <view wx:if="{{ role === 'super_admin' }}" class="menu-item" bindtap="goPermissionManage">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">权限管理</text>
        <view wx:if="{{ pendingCount > 0 }}" class="badge">{{ pendingCount }}</view>
        <text class="menu-arrow">›</text>
      </view>

      <!-- 分享（仅管理员） -->
      <button wx:if="{{ role !== 'viewer' }}" class="menu-item" open-type="share">
        <text class="menu-icon">📤</text>
        <text class="menu-label">分享给钓友</text>
        <text class="menu-arrow">›</text>
      </button>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-section">
    <text class="about-title">钓鱼赛事助手</text>
    <text class="about-desc">记录钓鱼荣誉，分享垂钓快乐</text>
    <text class="about-version">版本 1.0.0</text>
  </view>

  <view class="safe-bottom"></view>
</view>
