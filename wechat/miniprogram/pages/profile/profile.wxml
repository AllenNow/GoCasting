<!-- pages/profile/profile.wxml — 个人中心（精简版）-->
<view class="page-container">

  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view wx:if="{{ userInfo && userInfo.nickName }}" class="user-info">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{ userInfo.avatarUrl }}" mode="aspectFill" />
      </button>
      <text class="username">{{ userInfo.nickName }}</text>
      <text class="user-sub">钓鱼爱好者</text>
    </view>

    <!-- 未设置态 -->
    <view wx:else class="user-setup">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view wx:if="{{ userInfo && userInfo.avatarUrl }}" class="avatar-wrap">
          <image class="avatar" src="{{ userInfo.avatarUrl }}" mode="aspectFill" />
        </view>
        <view wx:else class="avatar-placeholder">🎣</view>
      </button>
      <text class="setup-hint">点击头像选择</text>
      <input
        class="nickname-input"
        type="nickname"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        placeholder="输入昵称完成设置"
      />
    </view>

    <!-- 管理员标识 -->
    <view wx:if="{{ isAdmin }}" class="admin-badge">
      <text>🔑 管理员</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="card">
      <button class="menu-item share-btn" open-type="share">
        <text class="menu-icon">📤</text>
        <text class="menu-label">分享给钓友</text>
        <text class="menu-arrow">›</text>
      </button>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-section">
    <text class="about-title">钓鱼赛事助手</text>
    <text class="about-desc">记录钓鱼荣誉，分享垂钓快乐</text>
    <text class="about-version">版本 1.0.0</text>
  </view>

  <view class="safe-bottom"></view>
</view>
