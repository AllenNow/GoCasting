/* pages/weather/weather.wxss — 潮汐+海洋仪表板完整样式 */

/* ── 全局 ─────────────────────────────────────────────────── */
.page-bg {
  min-height: 100vh;
  background: #f0f4f8;
}

/* ── 加载状态 ────────────────────────────────────────────── */
.loading-full {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1a7f5a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: #888; }

/* ── 错误栏 ─────────────────────────────────────────────── */
.error-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff8e6;
  padding: 18rpx 28rpx;
  border-bottom: 2rpx solid #ffe0a0;
}
.error-icon { font-size: 28rpx; }
.error-text { font-size: 24rpx; color: #b07800; flex: 1; }
.error-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #b07800;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border: 2rpx solid #d9a03a;
  border-radius: 24rpx;
}

/* ── 通用 section-card ──────────────────────────────────── */
.section-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 10rpx 16rpx 0;
  padding: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2a1a;
}

/* ════════════════════════════════════════════════════════
   区块1：顶部实况英雄卡
════════════════════════════════════════════════════════ */
.hero-card {
  background: linear-gradient(160deg, #0d5c42 0%, #1a7f5a 50%, #2d9e72 100%);
  padding: 28rpx 24rpx 22rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}
/* 装饰波浪背景 */
.hero-card::after {
  content: '';
  position: absolute;
  bottom: -20rpx;
  left: -10%;
  width: 120%;
  height: 40rpx;
  background: #f0f4f8;
  border-radius: 50% 50% 0 0;
  pointer-events: none;
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.hero-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.hero-location-icon { font-size: 26rpx; }
.hero-location-name {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.95;
  max-width: 230rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.hero-weather-mini {
  display: flex;
  gap: 12rpx;
  align-items: center;
  background: rgba(255,255,255,0.15);
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
}
.hero-weather-desc { font-size: 24rpx; opacity: 0.9; }
.hero-weather-temp { font-size: 26rpx; font-weight: 600; }

/* 顶部右侧：进入天气详情 */
.hero-detail {
  display: flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 100rpx;
  background: rgba(255,255,255,0.22);
}
.hero-detail-text { font-size: 22rpx; font-weight: 600; }
.hero-detail-arrow { font-size: 24rpx; line-height: 1; opacity: 0.85; }

/* 顶部右侧：刷新 + 天气 */
.hero-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-refresh {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
}
.hero-refresh-icon { font-size: 28rpx; color: #fff; line-height: 1; }
.hero-refresh.is-loading .hero-refresh-icon { animation: spin 0.9s linear infinite; }

/* 更新时间 + 海况局部刷新 */
.hero-update-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: -2rpx 0 8rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.62);
}
.hero-update-dot { opacity: 0.5; }
.hero-update-text { font-size: 20rpx; }
.mini-refresh {
  margin-left: auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
}
.mini-refresh-icon { font-size: 22rpx; color: #fff; line-height: 1; }
.mini-refresh.is-loading .mini-refresh-icon { animation: spin 0.9s linear infinite; }

/* 潮汐主体 */
.hero-tide-main {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 4rpx;
  flex-wrap: wrap;
}
.hero-tide-state {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.18);
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
}
.hero-tide-icon  { font-size: 28rpx; }
.hero-tide-label { font-size: 26rpx; font-weight: 700; }
.hero-tide-height { display: flex; align-items: baseline; gap: 4rpx; }
.hero-height-num  { font-size: 54rpx; font-weight: 800; line-height: 1; }
.hero-height-unit { font-size: 26rpx; opacity: 0.8; }
.hero-height-hint { font-size: 22rpx; opacity: 0.65; align-self: flex-end; padding-bottom: 8rpx; }

/* 四格数据 */
.hero-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  background: rgba(255,255,255,0.12);
  border-radius: 16rpx;
  margin: 12rpx 0 10rpx;
  overflow: hidden;
}
.hero-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 6rpx;
  gap: 2rpx;
  border-right: 1rpx solid rgba(255,255,255,0.15);
}
.hero-grid-item:last-child { border-right: none; }
.hero-grid-icon { font-size: 26rpx; }
.hero-grid-val  { font-size: 24rpx; font-weight: 700; }
.hero-grid-label{ font-size: 20rpx; opacity: 0.75; }

/* 出钓评分徽章 */
.fish-score-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.score-good { background: rgba(46, 213, 115, 0.35); }
.score-ok   { background: rgba(255, 191, 0, 0.35); }
.score-bad  { background: rgba(255, 71, 87, 0.35); }
.score-na   { background: rgba(255, 255, 255, 0.18); }
.fish-score-num { font-size: 28rpx; font-weight: 800; color: #fff; }

/* 今日洞察：最佳窗口 + 月相/潮型/气压 */
.hero-insight {
  margin: 8rpx 0 10rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
}
.insight-best { display: flex; flex-direction: column; gap: 4rpx; }
.insight-best-label { font-size: 22rpx; opacity: 0.72; }
.insight-best-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.insight-best-time { font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; }
.insight-best-score { font-size: 30rpx; font-weight: 800; }
.insight-best-max { font-size: 20rpx; opacity: 0.7; }
.insight-best-reason { font-size: 22rpx; opacity: 0.75; }
.insight-best-empty { font-size: 24rpx; opacity: 0.75; }
.insight-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}
.insight-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 24rpx;
  font-size: 21rpx;
}
.insight-chip-icon { font-size: 24rpx; }
.insight-chip-sub { font-size: 20rpx; opacity: 0.7; }
.hero-base-note {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  opacity: 0.55;
}

/* 底部海况 + 赶海 */
.hero-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 2rpx;
}
.hero-wave-desc { display: flex; flex-direction: column; gap: 4rpx; }
.hero-wave-tag  { font-size: 26rpx; font-weight: 700; }
.hero-wave-detail{ font-size: 22rpx; opacity: 0.75; }
.ganhai-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.ganhai-label { font-size: 20rpx; opacity: 0.75; }
.ganhai-dots  { display: flex; gap: 6rpx; }
.ganhai-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
}
.ganhai-dot-on { background: #7fffb2; }

/* ════════════════════════════════════════════════════════
   区块2：24h 潮位折线图
════════════════════════════════════════════════════════ */
.chart-legend {
  display: flex;
  gap: 16rpx;
}
.legend-item  { font-size: 22rpx; }
.legend-max   { color: #e85555; }
.legend-min   { color: #4a90d9; }

.tide-chart-wrap {
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;  /* tooltip 用 absolute 定位时的参考容器 */
}
.chart-yaxis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 230rpx;
  padding: 0 8rpx;
  position: absolute;
  z-index: 2;
}
.yaxis-label { font-size: 20rpx; color: #aaa; }

.tide-chart-body {
  position: relative;
  height: 230rpx; /* 修改高度需同步 weather.js 的 CHART_H_RPX，否则折线角度会失真 */
  margin: 0 0 6rpx;
  background: linear-gradient(180deg, #f0f7ff 0%, #e8f4fd 100%);
  border-radius: 12rpx;
  overflow: hidden;
}
.chart-gridline {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(100,150,200,0.15);
}

/* 折线点 */
.chart-point {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1a7f5a;
  margin-left: -4rpx;
  margin-top: -4rpx;
  z-index: 3;
}
.chart-point-tick {
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  margin-top: -6rpx;
  background: #0d5c42;
  border: 2rpx solid #fff;
}

/* 折线段（用 border-bottom 实现） */
.chart-line-seg {
  position: absolute;
  height: 3rpx;
  background: linear-gradient(90deg, #1a7f5a, #2d9e72);
  transform-origin: left center;
  border-radius: 2rpx;
  margin-top: -1.5rpx;
  z-index: 2;
}

/* 当前时刻游标 */
.chart-cursor {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 5;
}
.chart-cursor-line {
  width: 2rpx;
  flex: 1;
  background: rgba(232,85,85,0.6);
  border-style: dashed;
}
.chart-cursor-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e85555;
  border: 3rpx solid #fff;
  box-shadow: 0 0 8rpx rgba(232,85,85,0.5);
  position: absolute;
  top: 50%;
  margin-top: -7rpx;
  margin-left: -6rpx;
}
.chart-cursor-label {
  position: absolute;
  top: 4rpx;
  left: 0;
  transform: translateX(-50%);
  font-size: 18rpx;
  color: #e85555;
  font-weight: 600;
  white-space: nowrap;
  background: rgba(255,255,255,0.8);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}
/* 靠近右边缘时标签向左展开，避免被图表裁掉 */
.chart-cursor.cursor-flip .chart-cursor-label {
  left: auto;
  right: 0;
  transform: none;
}

/* 极值标注 */
.chart-extreme {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 4;
  transform: translateX(-50%);
}
.chart-extreme-high { margin-top: -72rpx; }
.chart-extreme-low  { margin-top: 8rpx; }
.chart-extreme-icon { font-size: 18rpx; line-height: 1.2; }
.chart-extreme-time { font-size: 18rpx; line-height: 1.2; font-weight: 700; color: #333; white-space: nowrap; }
.chart-extreme-val  { font-size: 18rpx; line-height: 1.2; color: #666; white-space: nowrap; }

/* X轴 */
.chart-xaxis {
  display: flex;
  justify-content: space-between;
  padding: 2rpx 0;
}
.xaxis-label { font-size: 20rpx; color: #aaa; }

/* ── 可拖动探针游标 ──────────────────────────────────────── */

/* 探针竖线容器（绝对定位，撑满图表高度） */
.probe-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  margin-left: -1rpx;
  z-index: 8;
  pointer-events: none;
  overflow: visible;  /* tooltip 超出容器边界时不裁剪 */
}

/* 蓝色竖线 */
.probe-line-bar {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 2rpx;
  background: #4a90d9;
  opacity: 0.85;
}

/* 交点圆点（随 probePointY 定位） */
.probe-dot {
  position: absolute;
  left: -9rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #4a90d9;
  box-shadow: 0 2rpx 8rpx rgba(74,144,217,0.5);
  margin-top: -10rpx;
}

/* 顶部拖动把手（大一点便于触摸） */
.probe-handle {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #4a90d9;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 10rpx rgba(74,144,217,0.6);
}

/* Tooltip 浮动数据卡（在 tide-chart-wrap 内绝对定位，覆盖在图表上） */
.probe-tooltip {
  position: absolute;
  top: 8rpx;          /* 图表顶部往下 8rpx */
  z-index: 20;
  background: rgba(15, 40, 80, 0.92);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  min-width: 170rpx;
  pointer-events: none;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
  transform: translateX(-50%);  /* 默认水平居中于游标 */
}
/* 游标在右侧（>62%）：tooltip 显示在左边 */
.probe-tooltip-left {
  transform: translateX(calc(-100% - 12rpx));
}
/* 游标在左侧（<=62%）：tooltip 显示在右边 */
.probe-tooltip-right {
  transform: translateX(12rpx);
}
.probe-tt-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.15);
}
.probe-tt-time  { font-size: 28rpx; font-weight: 800; color: #fff; }
.probe-tt-state { font-size: 20rpx; color: #7ec8f5; white-space: nowrap; }
.probe-tt-body  { display: flex; align-items: baseline; justify-content: space-between; gap: 8rpx; }
.probe-tt-label { font-size: 20rpx; color: rgba(255,255,255,0.55); }
.probe-tt-val   { font-size: 30rpx; font-weight: 800; color: #5bcefa; }

/* ════════════════════════════════════════════════════════
   区块4：48h浪况趋势
════════════════════════════════════════════════════════ */
.wave-legend {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.wl-item { display: flex; align-items: center; gap: 6rpx; }
.wl-dot  {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.wl-dot-wave  { background: #1a7f5a; }
.wl-dot-swell { background: #4a90d9; }
.wl-text { font-size: 22rpx; color: #888; }

.wave-scroll { width: 100%; }
.wave-scroll-inner {
  display: flex;
  align-items: flex-end;
  gap: 0;
  /* 旋转后的时间标签会向上溢出，这里预留空间，避免被 scroll-view 顶部裁切 */
  padding: 20rpx 0 4rpx;
  min-width: max-content;
}
.wave-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 36rpx;
  gap: 4rpx;
}
.wave-col-mark { background: rgba(26,127,90,0.04); border-radius: 6rpx; }

.wave-col-time {
  font-size: 17rpx;
  color: #888;
  white-space: nowrap;
  transform: rotate(-45deg);
  margin-bottom: 2rpx;
  height: 28rpx;
  line-height: 28rpx;
}
.invisible { opacity: 0; }

.wave-bar-group {
  display: flex;
  gap: 4rpx;
  align-items: flex-end;
  height: 92rpx;
  justify-content: center;
}
.wave-bar-group-48h { height: 72rpx; }
.wave-bar {
  width: 12rpx;
  border-radius: 3rpx 3rpx 0 0;
  min-height: 4rpx;
  transition: height 0.4s ease;
}
.wave-bar-wind  { background: #1a7f5a; opacity: 0.85; }
.wave-bar-swell { background: #4a90d9; opacity: 0.65; }

.wave-col-val {
  font-size: 16rpx;
  color: #666;
  margin-top: 2rpx;
}
.wave-col-sst {
  font-size: 16rpx;
  color: #e85555;
  margin-top: 0;
}

.wave-footer-note { margin-top: 2rpx; }
.wave-note-text { font-size: 18rpx; color: #ccc; }

/* ════════════════════════════════════════════════════════
   区块5：7天日历
════════════════════════════════════════════════════════ */
.calendar-scroll { width: 100%; }
/* 日历区块：压缩上下留白，减少纵向占用 */
.cal-section { padding: 12rpx 14rpx 8rpx; }
.cal-section .section-header { margin-bottom: 8rpx; }
.calendar-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 2rpx;
  min-width: max-content;
}
.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 124rpx;
  padding: 10rpx 10rpx;
  background: #f7fafc;
  border-radius: 16rpx;
  gap: 1rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.calendar-day-active {
  background: #e8f5ef;
  border-color: #1a7f5a;
}
.cal-head {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  line-height: 1.15;
}
.cal-date       { font-size: 20rpx; color: #999; line-height: 1.15; }
/* 日历卡：浪况图标与浪高同行、潮位同一行，压缩为 4 行 */
.cal-wave-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  margin-top: 1rpx;
  line-height: 1.1;
}
.cal-wave-emoji { font-size: 26rpx; line-height: 1.1; }
.cal-wave-val   { font-size: 24rpx; font-weight: 700; color: #1a2a1a; line-height: 1.15; margin-top: 0; }
.cal-wave-desc  { font-size: 18rpx; color: #888; line-height: 1.2; }
.cal-swell-row  { display: flex; gap: 4rpx; align-items: center; margin-top: 1rpx; }
.cal-swell-label{ font-size: 18rpx; color: #aaa; background: #eee; padding: 2rpx 6rpx; border-radius: 4rpx; }
.cal-swell-val  { font-size: 20rpx; color: #4a90d9; font-weight: 600; }

/* ── 选中日期详情网格（旧版，保留兼容）── */
.cal-detail {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7fafc;
  border-radius: 16rpx;
}
.cal-detail-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}
.cal-detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
  border-right: 1rpx solid #e8e8e8;
}
.cal-detail-item:last-child { border-right: none; }
.cal-detail-label { font-size: 20rpx; color: #aaa; }
.cal-detail-val   { font-size: 26rpx; font-weight: 700; color: #1a2a1a; }

/* ════════════════════════════════════════════════════════
   14天日历新增样式
════════════════════════════════════════════════════════ */

/* 图例 */
.cal-legend-row { display: flex; align-items: center; gap: 8rpx; }
.cal-legend-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
}
.cal-legend-past   { background: #ccc; }
.cal-legend-today  { background: #1a7f5a; }
.cal-legend-future { background: #4a90d9; }
.cal-legend-text   { font-size: 20rpx; color: #aaa; margin-right: 8rpx; }

/* 日历卡片新状态 */
.cal-today {
  background: #e8f5ef !important;
  border-color: #1a7f5a !important;
}
.cal-past {
  opacity: 0.7;
}
.cal-week {
  font-size: 21rpx;
  color: #666;
  font-weight: 600;
  line-height: 1.15;
  margin-bottom: 0;
}
.cal-week-today {
  color: #1a7f5a;
  font-weight: 700;
}
.cal-val-past { color: #bbb !important; }

/* 潮汐高低范围 */
.cal-tide-range {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 0;
}
.cal-tide-hi { font-size: 18rpx; color: #e85555; line-height: 1.15; }
.cal-tide-lo { font-size: 18rpx; color: #4a90d9; line-height: 1.15; }

/* ── 选中天展开详情区域 ─────────────────────────────── */
.day-detail-wrap {
  margin-top: 8rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 8rpx;
}
.day-detail-header {
  margin-bottom: 4rpx;
}

/* 来源标签 + 高低潮图例同一行 */
.day-chart-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 2rpx;
}
.day-chart-legend { display: flex; gap: 12rpx; }
.day-source-badge {
  display: inline-block;
  flex-shrink: 0;
  padding: 1rpx 10rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
}
.src-station { color: #1a7f5a; background: rgba(26, 127, 90, 0.10); }
.src-archive { color: #9a6b2f; background: rgba(154, 107, 47, 0.12); }
.src-model   { color: #8a8f99; background: rgba(138, 143, 153, 0.12); }
/* 基准面混排提示 */
.day-datum-tip {
  display: block;
  margin-bottom: 4rpx;
  font-size: 18rpx;
  line-height: 1.4;
  color: #9a6b2f;
}
.day-detail-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2a1a;
  display: block;
  line-height: 1.2;
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.day-detail-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
}
.day-meta-wave   { font-size: 20rpx; color: #1a7f5a; font-weight: 600; }
.day-meta-swell  { font-size: 20rpx; color: #4a90d9; }
.day-meta-dir    { font-size: 20rpx; color: #888; }
.day-meta-sep    { font-size: 18rpx; color: #ddd; }

/* 折线图区域标题 */
.day-detail-top {
  margin-bottom: 6rpx;
}
.day-chart-section { margin-bottom: 6rpx; }
.day-chart-max { font-size: 20rpx; color: #e85555; }
.day-chart-min { font-size: 20rpx; color: #4a90d9; }

/* 子区块 label */
.day-section-label {
  display: block;
  font-size: 20rpx;
  color: #aaa;
  font-weight: 600;
  margin: 6rpx 0 4rpx;
}

/* 逐小时浪况区域 */
.day-wave-wrap { margin-top: 4rpx; }
.wave-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}
.wave-toggle-row .day-section-label { margin: 0; }
.wave-toggle { font-size: 18rpx; color: #1a7f5a; }

/* 日统计四格已合并进顶部元信息（保留占位避免旧模板引用） */

/* ════════════════════════════════════════════════════════
   鱼口预测：评级徽章 + 最佳时段 + 热力图
════════════════════════════════════════════════════════ */

/* 详情标题行（与评级并排）*/
.day-detail-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rpx;
}

/* 全天评级徽章 */
.day-grade-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}
.grade-excellent { background: #e8f5ef; }
.grade-good      { background: #e8f5ef; }
.grade-ok        { background: #fff8e6; }
.grade-poor      { background: #fff3e0; }
.grade-bad       { background: #fff0f0; }
.day-grade-emoji { font-size: 24rpx; }
.day-grade-label { font-size: 22rpx; font-weight: 700; }
.grade-excellent .day-grade-label { color: #1a7f5a; }
.grade-good      .day-grade-label { color: #2dce89; }
.grade-ok        .day-grade-label { color: #e6a817; }
.grade-poor      .day-grade-label { color: #f5a623; }
.grade-bad       .day-grade-label { color: #e85555; }

/* 最佳垂钓时段 */
.best-windows-wrap {
  margin: 6rpx 0 4rpx;
  background: #f7fbf9;
  border-radius: 18rpx;
  padding: 10rpx 12rpx;
}
.best-windows-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.best-windows-title { font-size: 24rpx; font-weight: 700; color: #1a2a1a; }
.best-windows-hint  { font-size: 18rpx; color: #aaa; }

.window-scroll { width: 100%; }
.window-row {
  display: flex;
  gap: 8rpx;
  min-width: max-content;
  padding-bottom: 2rpx;
}
.window-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 330rpx;
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
}
.window-card:last-child { margin-right: 0; }
.grade-bg-excellent { background: rgba(26,127,90,0.1); }
.grade-bg-good      { background: rgba(45,206,137,0.1); }
.grade-bg-ok        { background: rgba(230,168,23,0.08); }
.grade-bg-poor      { background: rgba(245,166,35,0.08); }
.grade-bg-bad       { background: rgba(232,85,85,0.08); }

.window-card-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}
.window-emoji { font-size: 26rpx; flex-shrink: 0; }
.window-info  { display: flex; flex-direction: column; gap: 1rpx; }
.window-time  { font-size: 24rpx; font-weight: 700; color: #1a2a1a; line-height: 1.2; }
.window-duration { font-size: 18rpx; color: #888; line-height: 1.2; }

.window-score {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  flex-shrink: 0;
}
.window-score-num  { font-size: 30rpx; font-weight: 800; }
.window-score-max  { font-size: 18rpx; color: #aaa; }
.grade-excellent .window-score-num { color: #1a7f5a; }
.grade-good      .window-score-num { color: #2dce89; }
.grade-ok        .window-score-num { color: #e6a817; }
.grade-poor      .window-score-num { color: #f5a623; }
.grade-bad       .window-score-num { color: #e85555; }

/* 无最佳时段提示 */
.no-window-tip {
  background: #fff8e6;
  border-radius: 14rpx;
  padding: 8rpx 12rpx;
  margin: 6rpx 0;
  font-size: 20rpx;
  line-height: 1.3;
  color: #b07800;
}

/* 热力图 */
.fish-heatmap-wrap { margin-top: 4rpx; }
.heatmap-scroll { width: 100%; }
.heatmap-row {
  display: flex;
  align-items: flex-end;
  gap: 0;
  padding-bottom: 4rpx;
  min-width: max-content;
}
.heatmap-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 28rpx;
  gap: 4rpx;
}
.heatmap-bar-wrap {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.heatmap-bar {
  width: 20rpx;
  min-height: 4rpx;
  border-radius: 3rpx 3rpx 0 0;
  transition: height 0.3s;
}
.heatmap-score {
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1;
}
.heatmap-time {
  font-size: 15rpx;
  color: #aaa;
  white-space: nowrap;
  transform: rotate(-45deg);
  height: 28rpx;
  line-height: 28rpx;
}

/* 图例 */
.heatmap-legend {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
  padding: 0 4rpx;
}
.heatmap-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.heatmap-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.heatmap-legend-item text { font-size: 18rpx; color: #888; }

/* ════════════════════════════════════════════════════════
   区块6：海洋环境详情
════════════════════════════════════════════════════════ */
.ocean-detail-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}
.ocean-detail-col {
  background: #f7fafc;
  border-radius: 16rpx;
  overflow: hidden;
}
.ocean-col-header {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 10rpx;
}
.ocean-col-wind    { background: #e8f3ff; }
.ocean-col-swell   { background: #e8f5ef; }
.ocean-col-current { background: #fff3e8; }
.ocean-col-icon  { font-size: 22rpx; }
.ocean-col-title { font-size: 20rpx; font-weight: 700; color: #333; }

.ocean-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 10rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.ocean-detail-row:last-child { border-bottom: none; }
.od-label { font-size: 19rpx; color: #aaa; flex-shrink: 0; }
.od-val   { font-size: 20rpx; font-weight: 600; color: #333; text-align: right; }
.od-val-desc { color: #1a7f5a; }

/* 赶海点 */
.od-ganhai-dots { display: flex; gap: 4rpx; }
.od-ganhai-dot  {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #e0e0e0;
}
.od-ganhai-on { background: #1a7f5a; }

/* 评分文字颜色 */
.od-score      { font-size: 20rpx !important; }
.od-score-good { color: #1a7f5a !important; }
.od-score-ok   { color: #e6a817 !important; }
.od-score-bad  { color: #e85555 !important; }

/* ════════════════════════════════════════════════════════
   底部操作按钮
════════════════════════════════════════════════════════ */
.bottom-actions {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 16rpx 4rpx;
}
.btn-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 14rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.btn-map    { background: #e8f5ef; color: #1a7f5a; }
.btn-record { background: #1a7f5a; color: #fff; }
.btn-action-icon { font-size: 26rpx; }
.btn-action-text { font-size: 26rpx; }

.safe-bottom { height: 16rpx; }

/* ════════════════════════════════════════════════════════
   顶部地点切换按钮
════════════════════════════════════════════════════════ */
.hero-location {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.18);
  padding: 8rpx 18rpx 8rpx 14rpx;
  border-radius: 100rpx;
  max-width: 420rpx;
}
.hero-location-icon { font-size: 26rpx; flex-shrink: 0; }
.hero-location-name {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.95;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}
.hero-location-arrow { font-size: 20rpx; opacity: 0.75; flex-shrink: 0; }

/* 定位转圈 */
.locating-spin {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  flex-shrink: 0;
}

/* ════════════════════════════════════════════════════════
   地点选择面板
════════════════════════════════════════════════════════ */

/* 遮罩 */
.place-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 100;
}

/* 面板本体：默认藏在屏幕下方，open 时滑入 */
.place-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32,0.72,0,1), bottom 0.2s ease, max-height 0.2s ease;
}
.place-panel-open {
  transform: translateY(0);
}

/* 面板头部 */
.panel-header {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  position: relative;
  flex-shrink: 0;
}
.panel-handle {
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 72rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
}
.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2a1a;
  flex: 1;
  text-align: center;
}
.panel-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #888;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 4rpx 24rpx 16rpx;
  background: #f5f7fa;
  border-radius: 100rpx;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}
.search-icon { font-size: 28rpx; }
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: transparent;
}
.search-spin {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1a7f5a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  flex-shrink: 0;
}

/* 使用当前定位按钮 */
.locate-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 8rpx;
  padding: 20rpx 24rpx;
  background: #e8f5ef;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.locate-btn-icon { font-size: 36rpx; }
.locate-btn-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.locate-btn-title { font-size: 28rpx; font-weight: 600; color: #1a7f5a; }
.locate-btn-sub   { font-size: 20rpx; color: #888; }
.locate-active-badge {
  background: #1a7f5a;
  border-radius: 100rpx;
  padding: 4rpx 14rpx;
}
.locate-active-badge text { font-size: 20rpx; color: #fff; }

/* section label */
.panel-section-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 4rpx;
  flex-shrink: 0;
}
.panel-section-label {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  font-weight: 600;
  padding: 8rpx 28rpx 4rpx;
  flex-shrink: 0;
}
.panel-section-hint { font-size: 20rpx; color: #ccc; }

/* 地点列表 */
.place-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 16rpx;
}

.place-item {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
  border-radius: 16rpx;
}
.place-item:last-child { border-bottom: none; }
.place-item-active { background: #e8f5ef; }

.place-item-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.place-item-icon { font-size: 36rpx; flex-shrink: 0; }
.place-item-info { display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.place-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.place-item-addr {
  font-size: 20rpx;
  color: #aaa;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.place-item-right { flex-shrink: 0; }

/* 收藏按钮 */
.save-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #ccc;
}
.save-btn-saved { background: #fff8e6; color: #f5a623; }

/* 搜索无结果 */
.search-empty {
  text-align: center;
  padding: 48rpx 40rpx;
  font-size: 26rpx;
  color: #ccc;
}

/* 收藏为空 */
.saved-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx;
  gap: 12rpx;
}
.saved-empty-icon { font-size: 48rpx; color: #e0e0e0; }
.saved-empty-text { font-size: 24rpx; color: #ccc; text-align: center; }

.panel-safe-bottom { height: 60rpx; flex-shrink: 0; }

.data-disclaimer {
  padding: 14rpx 32rpx 24rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #aaa;
  text-align: center;
}

/* ════════════════════════════════════════════════════════
   天气预警
════════════════════════════════════════════════════════ */
.warn-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 28rpx;
  font-size: 24rpx;
}
.warn-blue   { background: #eef4ff; color: #2b5fa8; }
.warn-yellow { background: #fff9e6; color: #9a7400; }
.warn-orange { background: #fff1e6; color: #b45a00; }
.warn-red    { background: #ffeceb; color: #b32d26; }
.warn-icon   { font-size: 22rpx; }
.warn-title  {
  flex: 1;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.warn-toggle { font-size: 21rpx; opacity: 0.75; flex-shrink: 0; }
.warn-detail {
  background: #fffdf7;
  padding: 6rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #f0e6d0;
}
.warn-item { padding: 14rpx 0; border-bottom: 1rpx dashed #eee; }
.warn-item:last-child { border-bottom: none; }
.warn-item-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.warn-item-title { font-size: 24rpx; font-weight: 700; color: #5a4a2a; }
.warn-item-time  { font-size: 19rpx; color: #b8a888; flex-shrink: 0; }
.warn-item-text  { font-size: 22rpx; line-height: 1.6; color: #6a5a3a; }

/* ════════════════════════════════════════════════════════
   天光卡（日出日落弧线 + 黄金档）
════════════════════════════════════════════════════════ */
.sun-card {
  margin: 14rpx 16rpx 0;
  padding: 16rpx 18rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(165deg, #fffdf7 0%, #fdf3e1 100%);
  border: 1rpx solid rgba(240, 200, 130, 0.4);
  box-shadow: 0 4rpx 20rpx rgba(180, 140, 60, 0.12);
}
.sun-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sun-title-wrap { display: flex; align-items: baseline; gap: 10rpx; }
.sun-title { font-size: 30rpx; font-weight: 700; color: #5a4320; }
.sun-src {
  font-size: 18rpx;
  color: #a98a55;
  background: rgba(255, 255, 255, 0.7);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}
.sun-len { font-size: 22rpx; color: #a1804c; }

.sun-arc-wrap { position: relative; height: 132rpx; margin-top: 2rpx; }
.sun-arc {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 36rpx;
  height: 92rpx;
  border-top: 3rpx dashed rgba(240, 170, 70, 0.55);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.sun-horizon {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 36rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(240,170,70,0), rgba(240,170,70,0.55), rgba(240,170,70,0));
}
.sun-dot {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  margin-left: -13rpx;
  border-radius: 50%;
  z-index: 2;
  transition: left 0.6s ease, bottom 0.6s ease;
}
.sun-dot-day {
  background: radial-gradient(circle at 35% 35%, #ffe9a8, #ffb020 70%);
  box-shadow: 0 0 18rpx rgba(255, 170, 40, 0.85);
}
.sun-dot-night {
  background: #c9d4e0;
  box-shadow: 0 0 10rpx rgba(150, 170, 200, 0.6);
  opacity: 0.8;
}
.sun-edge { position: absolute; bottom: 6rpx; font-size: 20rpx; color: #a1804c; }
.sun-edge-left  { left: 0; }
.sun-edge-right { right: 0; }
.sun-status {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8a6c3c;
  margin-top: -2rpx;
}

.golden-row { display: flex; gap: 12rpx; margin-top: 8rpx; }
.golden-chip {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(240, 190, 110, 0.5);
  transition: background 0.2s, box-shadow 0.2s;
}
.golden-chip-active {
  background: #fff2d0;
  border-color: #f0b03a;
  box-shadow: 0 0 0 3rpx rgba(240, 176, 58, 0.25);
}
.golden-icon { font-size: 30rpx; }
.golden-info { display: flex; flex-direction: column; gap: 2rpx; }
.golden-label { font-size: 22rpx; font-weight: 700; color: #6a4d1d; }
.golden-time  { font-size: 20rpx; color: #a1804c; }

.sun-foot {
  display: flex;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed rgba(200, 160, 90, 0.35);
}
.sun-foot-item { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.sun-foot-tap { align-items: flex-end; }
.sun-foot-label { font-size: 20rpx; color: #b39462; }
.sun-foot-val   { font-size: 24rpx; font-weight: 700; color: #5a4320; }
.sun-foot-fish  { color: #c07a1a; }
.sun-foot-more  { font-size: 18rpx; font-weight: 400; color: #b39462; }

.sun-minutely {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(90, 140, 200, 0.1);
}
.sun-minutely-icon { font-size: 22rpx; }
.sun-minutely-text { flex: 1; font-size: 21rpx; color: #4a6a8a; }
.sun-minutely-rain {
  background: rgba(70, 130, 200, 0.16);
  box-shadow: inset 0 0 0 1rpx rgba(70, 130, 200, 0.18);
}

/* ════════════════════════════════════════════════════════
   今日节奏时间轴
════════════════════════════════════════════════════════ */
.timeline-hint { font-size: 18rpx; color: #aab2bd; }
.tl-wrap { position: relative; margin-top: 4rpx; }

.tl-track {
  position: relative;
  height: 64rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #22344a 0%, #16232f 100%);
}
.tl-day {
  position: absolute;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, #eaf6ff 0%, #cfe9ff 100%);
}
.tl-golden {
  position: absolute;
  top: 0;
  bottom: 0;
  background: rgba(255, 190, 60, 0.35);
  transition: background 0.25s;
}
.tl-golden-active {
  background: rgba(255, 168, 20, 0.8);
  box-shadow: inset 0 0 18rpx rgba(255, 160, 0, 0.9);
}
.tl-fish {
  position: absolute;
  bottom: 0;
  height: 34%;
  border-top: 2rpx solid rgba(130, 255, 205, 0.85);
  border-radius: 4rpx 4rpx 0 0;
  background: linear-gradient(180deg, rgba(45, 206, 137, 0.9), rgba(26, 127, 90, 0.9));
}
.tl-mark {
  position: absolute;
  top: 3rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  z-index: 3;
  pointer-events: none;
}
.tl-mark-icon { font-size: 16rpx; }
.tl-mark-time {
  font-size: 17rpx;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  padding: 1rpx 6rpx;
  border-radius: 8rpx;
  background: rgba(15, 32, 48, 0.55);
}
.tl-mark-high .tl-mark-icon { color: #ffd479; }
.tl-mark-low  .tl-mark-icon { color: #9fd8ff; }

.tl-now {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #ff5252;
  box-shadow: 0 0 8rpx rgba(255, 82, 82, 0.8);
  z-index: 4;
}
.tl-now-dot {
  position: absolute;
  top: 2rpx;
  left: -5rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff5252;
  border: 2rpx solid #fff;
}
.tl-cursor {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #fff;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.9);
  z-index: 5;
}
.tl-cursor::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: -7rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #4a90d9;
}
.tl-scale {
  display: flex;
  justify-content: space-between;
  padding: 2rpx 2rpx 0;
  font-size: 18rpx;
  color: #aab2bd;
}
.tl-tip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #f3f8fc;
  font-size: 22rpx;
  color: #4a5b6a;
  animation: tlTipIn 0.18s ease-out;
}
@keyframes tlTipIn {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.tl-tip-time  { font-size: 26rpx; font-weight: 800; color: #1a2a3a; }
.tl-tip-sep   { color: #c5d0da; }
.tl-tip-score { font-weight: 700; }
.tl-tip-state { color: #4a90d9; }

.tl-legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #9aa5b1;
}
.tl-legend-item { display: flex; align-items: center; gap: 6rpx; }
.tl-dot { width: 14rpx; height: 14rpx; border-radius: 4rpx; }
.tl-dot-day    { background: #cfe9ff; border: 1rpx solid #a9d4f5; }
.tl-dot-golden { background: #ffbe3c; }
.tl-dot-fish   { background: #1a7f5a; }
.tl-dot-arrow  { font-size: 18rpx; color: #7fb8d8; }

.probe-tt-unit { font-size: 18rpx; font-weight: 400; opacity: 0.8; }

