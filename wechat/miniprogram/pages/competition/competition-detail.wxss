/* pages/competition/competition-detail.wxss */

.page-container {
  min-height: 100vh;
  background: #f4f6f4;
  padding-bottom: 120rpx;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

/* ===== 顶部信息（压缩版）===== */
.comp-header {
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  padding: 20rpx 24rpx 16rpx;
}

.comp-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.comp-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
  line-height: 1.3;
}

.status-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.comp-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.comp-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

/* ===== 操作按钮行 ===== */
.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  gap: 12rpx;
}

.btn-share {
  background: rgba(255,255,255,0.2) !important;
  border: none !important;
  border-radius: 24rpx !important;
  padding: 8rpx 20rpx !important;
  font-size: 22rpx !important;
  color: #fff !important;
  line-height: 1.5 !important;
  display: flex !important;
  align-items: center !important;
}

.btn-share::after {
  display: none;
}

/* ===== 管理员按钮 ===== */
.admin-actions {
  display: flex;
  gap: 12rpx;
}

.admin-btn {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.btn-outline {
  border: 2rpx solid rgba(255,255,255,0.6);
  color: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-danger-outline {
  border: 2rpx solid rgba(232,85,85,0.7);
  color: #ffbbbb;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 空状态 ===== */
.empty-entries {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 60rpx; }

.empty-text {
  font-size: 28rpx;
  color: #666;
}

.btn-primary {
  background: #1a7f5a;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-entry-btn-center {
  padding: 16rpx 48rpx;
}

/* ===== 颁奖台（压缩版）===== */
.podium-section {
  background: #fff;
  margin: 12rpx 16rpx 0;
  border-radius: 16rpx;
  padding: 16rpx 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.podium-row {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 8rpx;
  padding: 0 4rpx;
}

.podium-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-medal {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.podium-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 2rpx;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.podium-stat {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.podium-stat-gold {
  color: #d4a000;
  font-weight: 700;
  font-size: 22rpx;
}

.podium-block {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx 6rpx 0 0;
}

.podium-rank-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.podium-block-gold   { height: 80rpx; background: linear-gradient(180deg, #f5c518, #d4a000); }
.podium-block-silver { height: 60rpx; background: linear-gradient(180deg, #c0c0c0, #a0a0a0); }
.podium-block-bronze { height: 48rpx; background: linear-gradient(180deg, #cd7f32, #a0622a); }

/* ===== 完整榜单 ===== */
.leaderboard-section {
  background: #fff;
  margin: 12rpx 16rpx 0;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-btns {
  display: flex;
  gap: 8rpx;
}

.btn-sm-green {
  background: #1a7f5a;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.btn-sm-outline {
  border: 2rpx solid #1a7f5a;
  color: #1a7f5a;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.leaderboard-list { display: flex; flex-direction: column; gap: 0; }

.entry-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.entry-row:last-child { border-bottom: none; }

.entry-row-top3 {
  background: #f9fdf9;
  padding: 12rpx 12rpx;
  margin: 0 -12rpx;
  border-radius: 8rpx;
  border-bottom: 1rpx solid #e8f5ee;
}

.entry-medal {
  font-size: 28rpx;
  width: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.entry-info {
  flex: 1;
  min-width: 0;
}

.entry-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 2rpx;
}

.entry-meta {
  display: flex;
  gap: 12rpx;
}

.entry-species {
  font-size: 20rpx;
  color: #666;
}

.entry-spot {
  font-size: 20rpx;
  color: #999;
}

.entry-note {
  font-size: 18rpx;
  color: #aaa;
  display: block;
}

.entry-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
}

.entry-main-stat {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a7f5a;
}

.entry-sub-stat {
  font-size: 20rpx;
  color: #999;
}

.entry-sub-pending {
  color: #ccc;
  font-style: italic;
}

.entry-admin-btns {
  display: flex;
  gap: 8rpx;
  margin-top: 4rpx;
}

.entry-btn-edit,
.entry-btn-del {
  font-size: 24rpx;
  padding: 2rpx 6rpx;
}

/* ===== 底部面板（选手编辑）===== */
.panel-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

.entry-panel {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 24rpx env(safe-area-inset-bottom);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  overflow-y: auto;
}

.entry-panel--visible {
  transform: translateY(0);
}

.panel-handle {
  width: 48rpx;
  height: 6rpx;
  background: #e0e0e0;
  border-radius: 3rpx;
  margin: 0 auto 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 16rpx;
}

.panel-form { display: flex; flex-direction: column; gap: 0; }

.form-group { margin-bottom: 16rpx; }

.form-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

.form-label.required::after {
  content: ' *';
  color: #e85555;
}

.form-input {
  width: 100%;
  height: 72rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1a1a1a;
  background: #fafafa;
  box-sizing: border-box;
}

.panel-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-bottom: 12rpx;
}

.panel-cancel-btn {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  color: #666;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-save-btn {
  flex: 2;
  height: 80rpx;
  font-size: 26rpx;
  padding: 0;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.safe-bottom { height: 20rpx; }

/* ===== 图片上传 ===== */
.photo-upload-area {
  display: flex;
  gap: 16rpx;
}

.photo-preview-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.photo-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  object-fit: cover;
}

.photo-remove-btn {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #e85555;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fafafa;
}

.photo-add-icon {
  font-size: 40rpx;
}

.photo-add-text {
  font-size: 22rpx;
  color: #999;
}

/* ===== 撤销栏 ===== */
.undo-bar {
  position: fixed;
  bottom: 40rpx;
  left: 24rpx;
  right: 24rpx;
  background: #333;
  color: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 99;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}

.undo-text {
  font-size: 26rpx;
  flex: 1;
}

.undo-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.undo-btn {
  color: #52d9a0;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.undo-dismiss {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

/* ===== 隐藏 Canvas ===== */
.share-canvas-hidden {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750px;
  height: 1200px;
}
