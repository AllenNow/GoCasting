<!-- pages/competition/competition.wxml — 比赛列表 -->
<view class="page-container">

  <!-- 顶部横幅 -->
  <view class="hero-banner">
    <text class="hero-title">🏆 钓鱼榜单</text>
    <text class="hero-sub">钓友记录与荣誉榜</text>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-tabs">
    <view
      wx:for="{{ filters }}"
      wx:key="value"
      class="filter-tab {{ filterStatus === item.value ? 'filter-tab--active' : '' }}"
      bindtap="onFilterTap"
      data-status="{{ item.value }}"
    >{{ item.label }}</view>
  </view>

  <!-- 加载骨架 -->
  <view wx:if="{{ loading }}" class="skeleton-wrap">
    <view wx:for="{{ [1,2,3] }}" wx:key="*this" class="skeleton-card">
      <view class="sk sk-title"></view>
      <view class="sk sk-meta"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{ filtered.length === 0 }}" class="empty-state">
    <text class="empty-icon">🏆</text>
    <text class="empty-text">暂无榜单</text>
    <text wx:if="{{ isAdmin }}" class="empty-sub">点击右下角「+」创建第一个榜单</text>
    <text wx:else class="empty-sub">敬请期待</text>
  </view>

  <!-- 比赛卡片列表 -->
  <view wx:else class="competition-list">
    <view
      wx:for="{{ filtered }}"
      wx:key="_id"
      class="competition-card"
      bindtap="onCompetitionTap"
      data-id="{{ item._id }}"
    >
      <view class="card-header">
        <text class="card-name">{{ item.name }}</text>
        <view class="status-badge" style="background:{{ item.statusColor }}">
          {{ item.statusLabel }}
        </view>
      </view>
      <view class="card-meta">
        <text class="meta-item">📅 {{ item.date }}</text>
        <text wx:if="{{ item.location }}" class="meta-item">📍 {{ item.location }}</text>
      </view>
      <view wx:if="{{ item.description }}" class="card-desc">{{ item.description }}</view>
      <view class="card-footer">
        <text class="entry-count">{{ item.entryCount }} 位上榜</text>
        <text class="card-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 管理员新建按钮（FAB） -->
  <view wx:if="{{ isAdmin }}" class="fab-btn" bindtap="addCompetition">
    <text class="fab-icon">＋</text>
  </view>

  <view class="safe-bottom"></view>
</view>

<privacy-popup />
