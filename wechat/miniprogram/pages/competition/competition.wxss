/* pages/competition/competition.wxss */

.page-container {
  min-height: 100vh;
  background: #f4f6f4;
  padding-bottom: 160rpx;
}

/* ===== 顶部横幅 ===== */
.hero-banner {
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.72);
}

/* ===== 筛选 Tab ===== */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
  overflow-x: auto;
}

.filter-tab {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #666;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
}

.filter-tab--active {
  background: #1a7f5a;
  color: #fff;
  border-color: #1a7f5a;
  font-weight: 600;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { padding: 16rpx 24rpx; }

.skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.sk {
  background: #ececec;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.sk-title { height: 36rpx; width: 60%; }
.sk-meta  { height: 26rpx; width: 80%; margin-bottom: 0; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

/* ===== 比赛卡片 ===== */
.competition-list {
  padding: 16rpx 24rpx 0;
}

.competition-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  line-height: 1.4;
}

.status-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
  /* 超过两行省略 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.entry-count {
  font-size: 24rpx;
  color: #999;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ===== FAB ===== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background: #1a7f5a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26,127,90,0.4);
  z-index: 10;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.safe-bottom { height: 40rpx; }
