<!-- pages/index/index.wxml — 工具首页 -->
<view class="page-container">

  <!-- 天气+潮汐快览卡片 -->
  <view class="weather-quick-card" bindtap="goWeather">
    <view class="wq-left">
      <text class="wq-label">天气 & 潮汐</text>
      <text class="wq-sub">点击查看详细仪表板</text>
    </view>
    <view class="wq-right">
      <text class="wq-icon">🌤️</text>
      <text class="wq-arrow">›</text>
    </view>
  </view>

  <!-- 快捷工具 -->
  <view class="quick-tools-row">
    <view class="quick-tool" bindtap="goGoScore">
      <text wx:if="{{ scoreReady }}" class="qt-score" style="color:{{ scoreColor }}">{{ todayScore }}</text>
      <text wx:else class="qt-icon">🎯</text>
      <text class="qt-label">出钓指数</text>
    </view>
    <view class="quick-tool" bindtap="goSpecies">
      <text class="qt-icon">🐟</text>
      <text class="qt-label">鱼种图鉴</text>
    </view>
    <view class="quick-tool" bindtap="goCompetition">
      <text class="qt-icon">🏆</text>
      <text class="qt-label">钓鱼榜单</text>
    </view>
  </view>

  <!-- 说明 -->
  <view class="data-disclaimer">
    <text>数据来自公开气象与潮汐服务，仅供参考；请遵守当地禁渔期与保护物种规定。</text>
  </view>
</view>
