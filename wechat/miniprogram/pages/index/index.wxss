/* pages/index/index.wxss */

/* 顶部统计横幅 */
.stats-banner {
  background: linear-gradient(135deg, #1a7f5a, #0d5c42);
  padding: 36rpx 32rpx 40rpx;
  color: #ffffff;
}

.stats-date {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.species-text {
  font-size: 30rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 快速记录按钮 */
.record-btn-wrap {
  padding: 24rpx 32rpx 0;
}

.record-btn {
  gap: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 127, 90, 0.25);
}

.record-icon {
  font-size: 36rpx;
}

/* 天气快览卡片 */
.weather-quick-card {
  margin: 16rpx 32rpx 0;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wq-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wq-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.wq-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.wq-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.wq-icon  { font-size: 44rpx; }
.wq-arrow { font-size: 36rpx; color: var(--color-text-hint); }

/* 分组标题 */
.section-header {
  padding: 28rpx 32rpx 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 渔获列表 */
.catches-list {
  padding: 0 24rpx;
}

.catch-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.catch-info {
  flex: 1;
  min-width: 0;
}

.catch-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.catch-species {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.release-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
}

.catch-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.catch-weight {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.catch-location {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.catch-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.catch-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.catch-bait {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

/* 渔获照片 */
.catch-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  object-fit: cover;
}

.catch-photo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 52rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 0 24rpx;
}

.skeleton-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.skeleton-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* 通用骨架块 */
.sk {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 400% 100%;
  border-radius: 8rpx;
  animation: shimmer 1.4s infinite;
}

@keyframes shimmer {
  0%   { background-position: 100% 50%; }
  100% { background-position: 0%   50%; }
}

.sk-title  { width: 55%;  height: 32rpx; }
.sk-meta   { width: 38%;  height: 24rpx; }
.sk-date   { width: 48%;  height: 22rpx; }
.sk-photo  {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

/* ===== 快捷工具行 ===== */
.quick-tools-row {
  display: flex;
  gap: 0;
  padding: 16rpx 24rpx 0;
  justify-content: space-between;
}
.quick-tool {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 8rpx;
  margin: 0 6rpx;
  box-shadow: var(--shadow-card);
  gap: 8rpx;
}
.qt-icon  { font-size: 40rpx; }
.qt-label { font-size: 20rpx; color: var(--color-text-secondary); text-align: center; }

/* ════════════════════════════════════════════
   空状态：新用户引导
════════════════════════════════════════════ */
.empty-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 60rpx;
}

/* 主图标：浮动动画 */
.empty-fish-wrap {
  margin-bottom: 24rpx;
  animation: float 2.5s ease-in-out infinite;
}
.empty-fish-icon { font-size: 96rpx; }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-16rpx); }
}

.empty-guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a2a1a;
  margin-bottom: 10rpx;
}
.empty-guide-sub {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 三步引导卡 */
.guide-steps {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.07);
}
.guide-step {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 20rpx;
}
.guide-step-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 28rpx;
}
.step-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #1a7f5a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.step-title { font-size: 28rpx; font-weight: 600; color: #1a2a1a; }
.step-desc  { font-size: 22rpx; color: #aaa; }
.step-icon  { font-size: 40rpx; flex-shrink: 0; }

/* 开始按钮 */
.guide-start-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(26,127,90,0.3);
  margin-bottom: 24rpx;
}
.guide-start-icon { font-size: 36rpx; }

/* 次级入口 */
.guide-secondary-row {
  display: flex;
  gap: 24rpx;
  width: 100%;
}
.guide-secondary-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  background: #f5f7fa;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #1a7f5a;
  font-weight: 600;
}
