/* pages/catch-detail/catch-detail.wxss — 渔获详情页样式 */

/* 照片区域 */
.photo-section {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 75%; /* 4:3 */
  overflow: hidden;
}

.detail-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-placeholder-icon {
  font-size: 120rpx;
  opacity: 0.5;
}

.released-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(26, 127, 90, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

/* 主信息区 */
.info-section {
  padding: 32rpx;
  background: var(--color-card);
}

.species-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.species-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.weight-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-value {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 条件信息卡片 */
.conditions-card {
  margin: 16rpx 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.condition-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.condition-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cond-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.cond-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

/* 备注卡片 */
.notes-card {
  margin: 16rpx 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.notes-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: var(--color-card);
  border-top: 2rpx solid var(--color-border);
  z-index: 100;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 24rpx;
}

.action-label {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.action-delete .action-label {
  color: var(--color-danger);
}

.action-btn-primary {
  flex: 1;
  background: var(--color-primary);
  color: #ffffff;
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* ════════════════════════════════════════════
   分享卡片弹窗
════════════════════════════════════════════ */
.share-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  z-index: 200;
}
.share-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f0f4f8;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 分享卡片主体 */
.share-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.12);
}
.sc-header {
  background: linear-gradient(135deg, #0d5c42, #1a7f5a);
  padding: 20rpx 28rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.sc-brand   { font-size: 30rpx; font-weight: 800; color: #fff; }
.sc-tagline { font-size: 22rpx; color: rgba(255,255,255,0.7); }

.sc-photo-wrap {
  width: 100%;
  height: 340rpx;
  overflow: hidden;
}
.sc-photo { width: 100%; height: 100%; object-fit: cover; }
.sc-photo-placeholder {
  width: 100%;
  height: 340rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.sc-main {
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sc-species { font-size: 44rpx; font-weight: 800; color: #1a2a1a; display: block; margin-bottom: 12rpx; }
.sc-stats-row { display: flex; gap: 24rpx; }
.sc-stat { display: flex; align-items: center; gap: 6rpx; }
.sc-stat-icon { font-size: 28rpx; }
.sc-stat-val  { font-size: 30rpx; font-weight: 700; color: #1a7f5a; }

.sc-meta {
  padding: 16rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.sc-meta-item { display: flex; align-items: center; gap: 10rpx; }
.sc-meta-icon { font-size: 24rpx; }
.sc-meta-text { font-size: 24rpx; color: #555; }

.sc-tackle {
  padding: 14rpx 28rpx;
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  border-bottom: 1rpx solid #f0f0f0;
}
.sc-tackle-item { font-size: 22rpx; color: #888; }

.sc-footer {
  padding: 14rpx 28rpx;
  background: #f9f9f9;
}
.sc-footer-text { font-size: 20rpx; color: #ccc; }

/* 操作按钮 */
.share-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.share-action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1.2;
}
.share-save-btn { background: #1a7f5a; color: #fff; }
.share-wx-btn   { background: #07c160; color: #fff; }
.share-cancel {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #888;
}
