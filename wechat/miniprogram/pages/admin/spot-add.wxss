/* pages/admin/spot-add.wxss */

/* 封面图区域 */
.cover-section {
  width: 100%;
  height: 360rpx;
  background: #1a1a2e;
  overflow: hidden;
  position: relative;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.cover-plus {
  font-size: 80rpx;
  color: rgba(255,255,255,0.3);
  line-height: 1;
}

.cover-hint {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

/* 表单主体 */
.form-body {
  padding: 24rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.required {
  color: var(--color-danger);
}

/* spot-add 页面特有：placeholder 样式（微信小程序必须用 placeholder-class，不能用全局）*/
.input-placeholder {
  color: var(--color-text-hint);
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* spot-add 页面特有：form-input 补充字体（全局 app.wxss 已定义基础样式）*/
.form-input {
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

/* 标签横向滚动（突破 form-body padding，全宽显示）*/
.tag-scroll-outer {
  margin: 0 -24rpx;
  padding: 4rpx 0;
  white-space: nowrap;
}

/* scroll-view 内部需要一个不换行的行容器 */
.tag-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}

/* 标签换行布局（目标鱼种用，文字较长）*/
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  flex-shrink: 0;
  white-space: nowrap;
}

/* 小号标签（用于换行布局，内容较长时） */
.tag-sm {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.tag-active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

/* 坐标选择 */
.location-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-location {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.coords-display {
  flex: 1;
  overflow: hidden;
}

.coords-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
  font-family: monospace;
}

.location-map {
  width: 100%;
  height: 280rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

/* 难度选择 */
.difficulty-row {
  display: flex;
  gap: 16rpx;
}

.diff-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}

.diff-active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

/* 提交/删除按钮 */
.submit-btn {
  background: var(--color-primary);
  color: #ffffff;
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.btn-disabled {
  opacity: 0.6;
}

.delete-btn {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--color-danger);
  margin-top: 16rpx;
}
