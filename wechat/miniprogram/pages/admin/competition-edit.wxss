/* pages/admin/competition-edit.wxss */

.page-container {
  min-height: 100vh;
  background: #f4f6f4;
  padding-bottom: 160rpx;
}

.form-wrap {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.form-group {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

/* 必填标记 */
.required::after {
  content: ' *';
  color: #e85555;
}

.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  border: none;
  outline: none;
  background: transparent;
  box-sizing: border-box;
}

.notes-area {
  height: auto;
  min-height: 120rpx;
  line-height: 1.6;
  padding: 0;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #1a1a1a;
}

.picker-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 16rpx;
}

.save-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #1a7f5a;
  color: #fff;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
