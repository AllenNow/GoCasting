/* pages/admin/gear-edit.wxss */

.cover-section {
  width: 100%;
  height: 280rpx;
  background: #1a1a2e;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-preview {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0; left: 0;
}

.cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.cover-plus { font-size: 60rpx; opacity: 0.5; }
.cover-hint { font-size: 26rpx; color: rgba(255,255,255,0.5); }

.cover-tip {
  position: absolute;
  bottom: 12rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

.form-body { padding: 24rpx; }

.price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-input { flex: 1; }

.price-dash {
  font-size: 28rpx;
  color: var(--color-text-hint);
  flex-shrink: 0;
}

.tier-row {
  display: flex;
  gap: 16rpx;
}

.tier-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  background: var(--color-bg);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}

.tier-active {
  background: var(--color-primary);
  color: #ffffff;
  border-color: var(--color-primary);
}

.submit-btn {
  background: var(--color-primary);
  color: #ffffff;
  text-align: center;
  padding: 28rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.btn-disabled { opacity: 0.6; }
