/* pages/admin/admin.wxss */

.admin-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.admin-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.admin-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.admin-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

.admin-section {
  padding: 24rpx 24rpx 8rpx;
}

.section-label {
  font-size: 22rpx;
  color: var(--color-text-hint);
  font-weight: 500;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.admin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-card);
}

.admin-card-disabled {
  opacity: 0.45;
}

.admin-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.admin-card-icon {
  font-size: 40rpx;
  width: 40rpx;
  text-align: center;
}

.admin-card-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.admin-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.admin-card-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.admin-card-arrow {
  font-size: 32rpx;
  color: var(--color-text-hint);
}
