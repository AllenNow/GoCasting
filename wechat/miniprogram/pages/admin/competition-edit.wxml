<!-- pages/admin/competition-edit.wxml — 管理员：比赛信息编辑 -->
<view class="page-container">
  <view class="form-wrap">

    <!-- 比赛名称 -->
    <view class="form-group">
      <text class="form-label required">比赛名称 *</text>
      <input
        class="form-input"
        placeholder="例：2026 夏季远投精英赛"
        value="{{ form.name }}"
        bindinput="onInput"
        data-field="name"
        maxlength="40"
      />
    </view>

    <!-- 比赛日期 -->
    <view class="form-group">
      <text class="form-label required">比赛日期 *</text>
      <picker mode="date" value="{{ form.date }}" bindchange="onDateChange">
        <view class="picker-row">
          <text class="picker-value">{{ form.date || '选择日期' }}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 举办地点 -->
    <view class="form-group">
      <text class="form-label">举办地点</text>
      <input
        class="form-input"
        placeholder="例：厦门观音山海滩"
        value="{{ form.location }}"
        bindinput="onInput"
        data-field="location"
        maxlength="40"
      />
    </view>

    <!-- 比赛状态 -->
    <view class="form-group">
      <text class="form-label">比赛状态</text>
      <picker
        mode="selector"
        range="{{ statusOptions }}"
        value="{{ statusIndex }}"
        bindchange="onStatusChange"
      >
        <view class="picker-row">
          <text class="picker-value">{{ statusOptions[statusIndex] }}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 简介 -->
    <view class="form-group">
      <text class="form-label">比赛简介</text>
      <textarea
        class="form-input notes-area"
        placeholder="可选：比赛规则、评分方式等"
        value="{{ form.description }}"
        bindinput="onInput"
        data-field="description"
        maxlength="200"
        auto-height
      />
    </view>

  </view>

  <!-- 底部保存按钮 -->
  <view class="action-bar safe-bottom">
    <view
      class="btn-primary save-btn {{ saving ? 'btn-disabled' : '' }}"
      bindtap="save"
    >
      <text wx:if="{{ saving }}">保存中…</text>
      <text wx:else>{{ isEdit ? '更新比赛' : '创建比赛' }}</text>
    </view>
  </view>
</view>
