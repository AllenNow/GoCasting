/* pages/admin/api-stats/api-stats.wxss — 第三方 API 用量统计 */

.page {
  min-height: 100vh;
  background: #f0f4f8;
}

/* ── Tab Bar ────────────────────────────────────────────── */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 26rpx;
  color: #888;
  position: relative;
}
.tab-active {
  color: #1a7f5a;
  font-weight: 700;
}
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #1a7f5a;
  border-radius: 2rpx;
}

/* ── 加载 ──────────────────────────────────────────────── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}
.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1a7f5a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #aaa; }

/* ── 通用卡片 ──────────────────────────────────────────── */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2a1a;
  margin-bottom: 20rpx;
  display: block;
}
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 12rpx;
  font-size: 28rpx;
  color: #aaa;
}
.empty-sub { font-size: 22rpx; color: #ccc; text-align: center; }

/* ── Tab1 总览：四格统计卡 ─────────────────────────────── */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 20rpx 0;
}
.stat-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.stat-card-success { background: #e8f5ef; }
.stat-card-fail    { background: #fff0f0; }
.stat-card-latency { background: #f0f6ff; }
.stat-num   { font-size: 48rpx; font-weight: 800; color: #1a2a1a; }
.stat-label { font-size: 22rpx; color: #888; }

/* 成功率进度条 */
.rate-bar-wrap {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.rate-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a7f5a, #2dce89);
  border-radius: 8rpx;
  transition: width 0.5s;
}
.rate-label { font-size: 24rpx; font-weight: 700; color: #1a7f5a; }

/* 14天柱形图 */
.bar-chart {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 160rpx;
  padding-bottom: 36rpx;
  overflow-x: auto;
}
.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 32rpx;
  gap: 0;
}
.bar-num {
  font-size: 16rpx;
  color: #888;
  margin-bottom: 4rpx;
  min-height: 20rpx;
  line-height: 20rpx;
}
.bar-num-zero { color: #ddd; }
.bar-body {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-fill {
  width: 80%;
  min-height: 4rpx;
  background: linear-gradient(180deg, #1a7f5a, #2dce89);
  border-radius: 4rpx 4rpx 0 0;
  transition: height 0.4s;
}
.bar-label {
  font-size: 16rpx;
  color: #aaa;
  margin-top: 6rpx;
  white-space: nowrap;
}

/* ── 接口行（总览 + Tab2 共用） ─────────────────────────── */
.api-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 12rpx;
}
.api-row:last-child { border-bottom: none; }
.api-row-left  { display: flex; align-items: center; gap: 10rpx; flex: 1; min-width: 0; }
.api-row-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }

.api-group-tag {
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.tag-amap       { background: #e8f3ff; color: #1a6fc4; }
.tag-open_meteo { background: #e8f5ef; color: #1a7f5a; }

.api-name  { font-size: 24rpx; color: #333; flex: 1; min-width: 0; }
.api-cnt   { font-size: 24rpx; font-weight: 700; color: #333; }
.api-mini-bar-bg {
  width: 60rpx;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}
.api-mini-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #1a7f5a;
}
.fill-warn { background: #e85555; }
.fill-ok   { background: #1a7f5a; }
.rate-ok   { font-size: 20rpx; color: #1a7f5a; }
.rate-warn { font-size: 20rpx; color: #e85555; }
.api-latency { font-size: 20rpx; color: #aaa; }

/* ── Tab2 表格 ──────────────────────────────────────────── */
.table-head, .table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx;
  gap: 0;
}
.table-head { border-bottom: 2rpx solid #f0f0f0; }
.table-row  { border-bottom: 1rpx solid #f8f8f8; }
.table-row:last-child { border-bottom: none; }
.th { font-size: 20rpx; color: #bbb; }
.td { font-size: 24rpx; color: #333; }
.th-name,  .td-name  { flex: 3; display: flex; align-items: center; gap: 8rpx; }
.th-total, .td-total { flex: 1; text-align: center; }
.th-fail,  .td-fail  { flex: 1; text-align: center; }
.th-rate,  .td-rate  { flex: 2; display: flex; align-items: center; gap: 8rpx; }
.th-ms,    .td-ms    { flex: 1.5; text-align: right; font-size: 20rpx; color: #aaa; }
.inline-bar {
  width: 40rpx;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.inline-bar-fill { height: 100%; border-radius: 4rpx; }
.txt-warn  { color: #e85555; }
.txt-mute  { color: #ccc; }

/* ── Tab3 用户卡 ────────────────────────────────────────── */
.user-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 16rpx 20rpx 0;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.user-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  gap: 16rpx;
}
.user-rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f4f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
}
.rank-top { background: transparent; font-size: 32rpx; }
.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.user-openid { font-size: 26rpx; font-weight: 700; color: #1a2a1a; font-family: monospace; }
.user-apis-summary { font-size: 20rpx; color: #aaa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.user-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}
.user-total { font-size: 26rpx; font-weight: 700; color: #1a7f5a; }
.user-last  { font-size: 18rpx; color: #bbb; }
.user-arrow {
  font-size: 32rpx;
  color: #ccc;
  transition: transform 0.2s;
  flex-shrink: 0;
}
.arrow-down { transform: rotate(90deg); }

/* 成功率条 */
.user-rate-bar {
  height: 8rpx;
  background: #f0f0f0;
  position: relative;
  overflow: hidden;
}
.user-rate-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a7f5a, #2dce89);
  transition: width 0.5s;
}
.user-rate-txt { display: none; } /* 视觉上用条形展示，不显示文字 */

/* 用户详情展开区 */
.user-detail {
  background: #f7fafc;
  border-top: 2rpx solid #eee;
  padding: 20rpx 24rpx;
}
.detail-loading { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0; }
.detail-section { margin-bottom: 20rpx; }
.detail-section-title {
  font-size: 22rpx;
  color: #aaa;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}
.detail-api-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eee;
}
.detail-api-row:last-child { border-bottom: none; }
.detail-api-name { font-size: 24rpx; color: #333; flex: 1; }
.detail-api-cnt  { font-size: 24rpx; font-weight: 700; color: #1a7f5a; }
.detail-api-fail { font-size: 20rpx; color: #e85555; margin-left: 8rpx; }

/* 调用记录行 */
.record-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}
.record-row:last-child { border-bottom: none; }
.record-left  { display: flex; align-items: center; gap: 8rpx; flex: 1; }
.record-right { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.record-name  { font-size: 22rpx; color: #555; }
.record-status {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
}
.status-ok   { background: #e8f5ef; color: #1a7f5a; }
.status-fail { background: #fff0f0; color: #e85555; }
.record-time    { font-size: 18rpx; color: #aaa; }
.record-latency { font-size: 18rpx; color: #888; }
.record-error {
  width: 100%;
  font-size: 18rpx;
  color: #e85555;
  background: #fff5f5;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  word-break: break-all;
}

/* ── Tab4 失败记录 ──────────────────────────────────────── */
.fail-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.fail-row:last-child { border-bottom: none; }
.fail-row-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.fail-api-name { font-size: 24rpx; font-weight: 600; color: #333; flex: 1; min-width: 0; }
.fail-openid   { font-size: 18rpx; color: #aaa; font-family: monospace; }
.fail-time     { font-size: 18rpx; color: #bbb; flex-shrink: 0; }
.fail-error    { font-size: 20rpx; color: #e85555; background: #fff5f5; padding: 8rpx 12rpx; border-radius: 8rpx; word-break: break-all; }

.safe-bottom { height: 40rpx; }
