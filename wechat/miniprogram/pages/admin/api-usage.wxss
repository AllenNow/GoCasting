/* pages/admin/api-usage.wxss — API 用量与费用 */

.page {
  min-height: 100vh;
  background: #f4f6f4;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 顶部栏 ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.month-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.chip-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.refresh-btn {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #1a7f5a;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.refresh-btn.is-loading .refresh-icon {
  animation: spin 1s linear infinite;
}

.refresh-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ===== 汇总卡 ===== */
.summary {
  background: linear-gradient(135deg, #1a7f5a 0%, #2f9d72 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
}

.summary-cost {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  margin: 8rpx 0 4rpx;
  letter-spacing: 1rpx;
}

.summary-sub {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
}

.summary-grid {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-num {
  font-size: 34rpx;
  font-weight: 600;
}

.grid-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

/* ===== 每日柱状图 ===== */
.chart-scroll {
  width: 100%;
}

.chart {
  display: inline-flex;
  align-items: flex-end;
  height: 240rpx;
  padding-bottom: 28rpx;
}

.chart-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  flex: 0 0 44rpx;
  height: 100%;
}

.chart-bar-wrap {
  flex: 1;
  width: 22rpx;
  display: flex;
  align-items: flex-end;
}

.chart-bar {
  width: 100%;
  min-height: 2rpx;
  background: linear-gradient(180deg, #56c596 0%, #1a7f5a 100%);
  border-radius: 6rpx 6rpx 0 0;
}

.chart-x {
  font-size: 18rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ===== 接口明细 ===== */
.api-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.api-row:last-child {
  border-bottom: none;
}

.api-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.api-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.api-cost {
  font-size: 28rpx;
  color: #e07a1f;
  font-weight: 600;
}

.api-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.api-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.price-tag {
  font-size: 20rpx;
  color: #1a7f5a;
  background: #e8f5ee;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
}

.price-note {
  font-size: 20rpx;
  color: #bbb;
}

/* ===== 空状态 / 提示 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #999;
}

.empty-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.tip {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
  padding: 8rpx 0 24rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
