/* pages/spot-map/spot-map.wxss */

.map-page {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.full-map {
  width: 100%;
  height: 100%;
}

/* 顶部提示条 */
.map-tip {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  white-space: nowrap;
  pointer-events: none;
}

/* 右侧工具栏 */
.map-toolbar {
  position: absolute;
  right: 24rpx;
  bottom: 300rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool-btn {
  width: 80rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 底部浮层面板 */
.bottom-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.12);
}

.slide-up {
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.panel-close {
  font-size: 28rpx;
  color: var(--color-text-hint);
  padding: 8rpx 12rpx;
}

.panel-body {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coord-hint {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.panel-input {
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text-primary);
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.public-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.public-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.public-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.save-spot-btn {
  width: 100%;
  padding: 26rpx;
  font-size: 30rpx;
  border-radius: var(--radius-md);
}

/* 钓点详情 */
.spot-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.spot-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.spot-coord {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.spot-actions {
  margin-top: 8rpx;
}

.nav-btn {
  width: 100%;
  padding: 26rpx;
  font-size: 30rpx;
  border-radius: var(--radius-md);
  gap: 8rpx;
}

/* ===== 钓点关联渔获 ===== */
.spot-catches-section {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
}

.spot-catches-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.spot-catches-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.spot-catches-count {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.spot-catches-loading,
.spot-catches-empty {
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 16rpx 0;
}

.spot-catches-list {
  max-height: 320rpx;
  overflow-y: auto;
}

.spot-catch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.spot-catch-item:last-child {
  border-bottom: none;
}

.sc-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sc-species {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.sc-date {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.sc-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sc-weight {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.sc-arrow {
  font-size: 28rpx;
  color: var(--color-text-hint);
}
