<!-- pages/spot-map/spot-map.wxml — 钓点地图 -->
<view class="map-page">

  <!-- 地图主体（全屏）-->
  <map
    id="fishingMap"
    class="full-map"
    latitude="{{ latitude }}"
    longitude="{{ longitude }}"
    scale="{{ scale }}"
    markers="{{ markers }}"
    show-location="{{ showLocation }}"
    show-scale="{{ true }}"
    enable-rotate="{{ false }}"
    enable-overlooking="{{ false }}"
    bindmarkertap="onMarkerTap"
    bindlongtap="onMapLongPress"
    bindregionchange="onRegionChange"
  />

  <!-- 顶部：搜索 / 筛选 / 参考提示 -->
  <view class="map-topcard">
    <view class="search-row">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索钓点名 / 区域 / 鱼种"
        placeholder-class="search-placeholder"
        value="{{ searchKeyword }}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text wx:if="{{ searchKeyword }}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>

    <scroll-view class="type-scroll" scroll-x enhanced show-scrollbar="{{ false }}">
      <view class="type-chips">
        <view
          wx:for="{{ waterTypes }}"
          wx:key="value"
          class="type-chip {{ typeFilter === item.value ? 'active' : '' }}"
          data-type="{{ item.value }}"
          bindtap="onTypeFilter"
        >{{ item.label }}</view>
      </view>
    </scroll-view>

    <view class="filter-row">
      <text class="spot-count">{{ visibleCount }} 个钓点</text>
      <view class="sort-btn {{ sortMode === 'distance' ? 'active' : '' }}" bindtap="toggleSort">
        {{ sortMode === 'distance' ? '📍 距离优先' : '默认排序' }}
      </view>
      <text class="legal-inline">信息仅供参考，请自行核实</text>
    </view>

    <view wx:if="{{ fitnessLabel }}" class="fitness-row fitness-row-{{ fitnessLevel }}">
      <text class="fitness-text">{{ fitnessLabel }}</text>
    </view>

    <view wx:if="{{ showClosedTip }}" class="closed-tip">
      <text class="closed-text">🌊 伏季休渔期（一般为 5/1–9/16），禁渔水域禁止垂钓，请以当地公告为准。</text>
      <text class="closed-close" bindtap="onClosedTipClose">✕</text>
    </view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{ !loading && visibleCount === 0 }}" class="empty-card">
    <text class="empty-icon">🎣</text>
    <text class="empty-title">没有符合条件的钓点</text>
    <text class="empty-sub">{{ canAddSpot ? '可调整筛选，或点击 ＋ 录入钓点' : '试试切换类型或清除搜索关键词' }}</text>
    <view class="empty-btn" bindtap="resetFilters">清除筛选</view>
  </view>

  <!-- 右侧工具栏 -->
  <view class="map-toolbar">
    <view wx:if="{{ canAddSpot }}" class="tool-btn tool-btn-add" bindtap="startAddSpot">
      <text>＋</text>
    </view>
    <view class="tool-btn" bindtap="goToMyLocation">
      <text>📍</text>
    </view>
    <view class="tool-btn" bindtap="onRefresh">
      <text>🔄</text>
    </view>
  </view>

  <!-- 底部：录入 / 编辑钓点面板 -->
  <view wx:if="{{ showAddPanel }}" class="bottom-panel slide-up">
    <view class="panel-header">
      <text class="panel-title">{{ editingId ? '✏️ 编辑钓点' : '📌 新建钓点' }}</text>
      <text class="panel-close" bindtap="closePanel">✕</text>
    </view>
    <scroll-view scroll-y class="panel-scroll">
      <view class="panel-body">
        <!-- 管理员新建时可选择归属 -->
        <view wx:if="{{ !editingId }}" class="target-switch">
          <view
            class="target-opt {{ formTarget === 'official' ? 'active' : '' }}"
            data-target="official"
            bindtap="setFormTarget"
          >⭐ 精选钓点</view>
          <view
            class="target-opt {{ formTarget === 'private' ? 'active' : '' }}"
            data-target="private"
            bindtap="setFormTarget"
          >🔒 我的钓点</view>
        </view>
        <text wx:if="{{ editingId }}" class="coord-hint">🔒 仅我自己可见</text>

        <text class="coord-hint">📍 {{ tapLatStr }}, {{ tapLonStr }}</text>

        <input
          class="panel-input"
          placeholder="钓点名称（必填，如：×× 灯塔外礁）"
          value="{{ newSpot.name }}"
          bindinput="onNewSpotNameInput"
          maxlength="30"
        />

        <picker range="{{ waterTypeNames }}" bindchange="onWaterTypeChange">
          <view class="picker-box {{ newSpot.waterType ? '' : 'placeholder' }}">
            {{ newSpot.waterType || '选择钓法类型（必填）' }}
          </view>
        </picker>

        <input
          class="panel-input"
          placeholder="目标鱼种（选填，如：黑鲷、鲈鱼）"
          value="{{ newSpot.targetFish }}"
          bindinput="onTargetFishInput"
          maxlength="30"
        />

        <input
          class="panel-input"
          placeholder="安全提示（选填，如：涨潮时礁石易被淹）"
          value="{{ newSpot.safetyTip }}"
          bindinput="onSafetyTipInput"
          maxlength="60"
        />

        <input
          class="panel-input"
          placeholder="备注（选填）"
          value="{{ newSpot.description }}"
          bindinput="onNewSpotDescInput"
          maxlength="60"
        />

        <picker wx:if="{{ formTarget === 'official' }}" range="{{ dangerLevels }}" bindchange="onDangerChange">
          <view class="picker-box">危险度：{{ newSpot.dangerLevel }}</view>
        </picker>

        <view class="switch-row">
          <view class="switch-info">
            <text class="switch-label">位于禁渔区 / 保护区</text>
            <text class="switch-sub">{{ formTarget === 'official' ? '精选钓点不可录入禁渔区 / 保护区' : '开启后详情会显示风险提示' }}</text>
          </view>
          <switch checked="{{ newSpot.protectedArea }}" bindchange="onProtectedChange" color="#e85555" />
        </view>

        <text class="form-legal">请确认该位置不在禁渔区、保护区或私人水域内；钓点信息由录入者负责核实。</text>

        <view class="btn-primary save-spot-btn" bindtap="saveSpot">{{ editingId ? '保存修改' : '保存钓点' }}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部：钓点详情面板 -->
  <view wx:if="{{ showDetailPanel && selectedSpot }}" class="bottom-panel slide-up">
    <view class="panel-header">
      <text class="panel-title">🎣 {{ selectedSpot.name }}</text>
      <text class="panel-close" bindtap="closePanel">✕</text>
    </view>
    <scroll-view scroll-y class="panel-scroll">
      <view class="panel-body">
        <view class="tag-row">
          <text class="tag {{ selectedSpot.isOfficial ? 'tag-gold' : 'tag-gray' }}">
            {{ selectedSpot.isOfficial ? '⭐ 精选钓点' : '🔒 我的钓点' }}
          </text>
          <text class="tag tag-type">{{ selectedSpot.typeLabel }}</text>
          <text wx:if="{{ selectedSpot.isOfficial && selectedSpot.dangerLabel }}" class="tag tag-danger">危险度 {{ selectedSpot.dangerLabel }}</text>
          <text wx:if="{{ selectedSpot.isFavorite }}" class="tag tag-fav">★ 已收藏</text>
        </view>

        <text wx:if="{{ selectedSpot.description }}" class="spot-desc">{{ selectedSpot.description }}</text>

        <view wx:if="{{ selectedSpot.distanceStr }}" class="info-line">
          <text class="info-label">距离</text>
          <text class="info-value">直线约 {{ selectedSpot.distanceStr }}</text>
        </view>
        <view wx:if="{{ selectedSpot.region }}" class="info-line">
          <text class="info-label">区域</text>
          <text class="info-value">{{ selectedSpot.region }}</text>
        </view>
        <view wx:if="{{ selectedSpot.target_fish }}" class="info-line">
          <text class="info-label">目标鱼种</text>
          <text class="info-value">{{ selectedSpot.target_fish }}</text>
        </view>

        <view wx:if="{{ selectedSpot.protected_area }}" class="warn-line">
          ⚠️ 该位置可能位于禁渔区 / 保护区，请务必自行核实后再决定是否前往。
        </view>
        <view wx:if="{{ selectedSpot.safety_tip }}" class="warn-line warn-safe">
          🛟 {{ selectedSpot.safety_tip }}
        </view>

        <view wx:if="{{ selectedSpot.tideList.length }}" class="tide-box">
          <text class="tide-title">今日高低潮（模型推算，仅供参考）</text>
          <view class="tide-list">
            <view wx:for="{{ selectedSpot.tideList }}" wx:key="index" class="tide-item">
              <text class="tide-name">{{ item.icon }} {{ item.label }} {{ item.timeStr }}</text>
              <text class="tide-level">{{ item.level }}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{ selectedSpot.isOfficial }}" class="source-line">
          来源：{{ selectedSpot.source }}<text wx:if="{{ selectedSpot.verifiedStr }}"> · 更新于 {{ selectedSpot.verifiedStr }}</text>
        </view>
        <view wx:if="{{ selectedSpot.showCoords && selectedSpot.latStr }}" class="source-line">
          坐标：{{ selectedSpot.latStr }}, {{ selectedSpot.lonStr }}
        </view>
        <view wx:if="{{ !selectedSpot.isOfficial && selectedSpot.createdStr }}" class="source-line">
          创建于 {{ selectedSpot.createdStr }}
        </view>

        <view class="panel-actions">
          <view class="btn-primary nav-btn" bindtap="navigateToSpot">🗺️ 在地图中查看</view>
          <view class="btn-ghost act-btn" bindtap="toggleFavorite">{{ selectedSpot.isFavorite ? '取消收藏' : '收藏' }}</view>
          <view class="btn-ghost act-btn" bindtap="copySpotInfo">复制</view>
        </view>

        <view class="sub-actions">
          <text wx:if="{{ selectedSpot.isOfficial }}" class="link-btn" bindtap="reportSpot">信息有误？纠错 ›</text>
          <text wx:else class="link-btn" bindtap="editSpot">编辑</text>
          <text wx:if="{{ !selectedSpot.isOfficial }}" class="link-btn link-danger" bindtap="deleteSpot">删除</text>
        </view>

        <view class="disclaimer-line" bindtap="goDisclaimer">
          ⚠️ 钓点信息仅供参考，不构成出钓或安全建议；请自行核实是否禁钓并注意人身安全。查看免责声明 ›
        </view>
      </view>
    </scroll-view>
  </view>

</view>

<!-- 首次进入的一次性提示 -->
<view wx:if="{{ showDisclaimer }}" class="dlg-mask" catchtouchmove="noop">
  <view class="dlg-card">
    <text class="dlg-title">使用提示</text>
    <text class="dlg-text">钓点信息由管理员整理或你本人添加，可能存在延迟与误差，仅供参考，不构成出钓、安全或合法性建议。</text>
    <text class="dlg-text">请自行核实当地禁渔期、保护区与钓场规定；禁止电鱼、毒鱼、炸鱼、锚鱼及多杆多钩等违规行为。</text>
    <view class="dlg-actions">
      <view class="dlg-btn ghost" bindtap="goDisclaimer">查看免责声明</view>
      <view class="dlg-btn primary" bindtap="onDisclaimerAck">我已知晓</view>
    </view>
  </view>
</view>

<privacy-popup bind:agree="onPrivacyAgree" />
