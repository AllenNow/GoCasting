<!-- pages/species/species.wxml — 鱼种图鉴 -->
<view class="page-container">

  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input-full"
      placeholder="搜索鱼种名称…"
      value="{{ keyword }}"
      bindinput="onSearch"
    />
  </view>

  <!-- 鱼种网格 -->
  <view class="species-grid">
    <view
      wx:for="{{ filtered }}"
      wx:key="id"
      class="species-card"
      bindtap="onTap"
      data-id="{{ item.id }}"
    >
      <view class="species-icon-wrap" style="background:{{ item.color }}22">
        <text class="species-icon">{{ item.icon }}</text>
      </view>
      <text class="species-card-name">{{ item.name }}</text>
      <text class="species-card-en">{{ item.en }}</text>
      <view class="species-category">{{ item.category }}</view>
    </view>
  </view>

  <view wx:if="{{ filtered.length === 0 }}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到「{{ keyword }}」</text>
  </view>

  <!-- 详情底层弹窗 -->
  <view wx:if="{{ selectedItem }}" class="detail-mask" bindtap="closeDetail">
    <view class="detail-panel" catchtap="">
      <view class="detail-header" style="background:{{ selectedItem.color }}">
        <text class="detail-icon">{{ selectedItem.icon }}</text>
        <view class="detail-title-group">
          <text class="detail-name">{{ selectedItem.name }}</text>
          <text class="detail-en">{{ selectedItem.en }}</text>
        </view>
        <view class="detail-close" bindtap="closeDetail">✕</view>
      </view>
      <scroll-view scroll-y class="detail-body">
        <view class="detail-row"><text class="dr-label">栖息地</text><text class="dr-val">{{ selectedItem.habitat }}</text></view>
        <view class="detail-row"><text class="dr-label">最佳季节</text><text class="dr-val">{{ selectedItem.season }}</text></view>
        <view class="detail-row"><text class="dr-label">常见体型</text><text class="dr-val">{{ selectedItem.size }}</text></view>
        <view class="detail-row"><text class="dr-label">常见重量</text><text class="dr-val">{{ selectedItem.weight }}</text></view>
        <view class="divider"></view>
        <view class="detail-row"><text class="dr-label">推荐饵料</text><text class="dr-val">{{ selectedItem.bait }}</text></view>
        <view class="detail-row"><text class="dr-label">推荐钓组</text><text class="dr-val">{{ selectedItem.rig }}</text></view>
        <view class="detail-row"><text class="dr-label">推荐竿力</text><text class="dr-val">{{ selectedItem.rodPower }}</text></view>
        <view class="divider"></view>
        <view class="tips-box">
          <text class="tips-label">💡 钓手心得</text>
          <text class="tips-text">{{ selectedItem.tips }}</text>
        </view>
        <view class="detail-action" bindtap="goRecord">
          <view class="btn-primary" style="width:100%;text-align:center;padding:22rpx">记录一次渔获</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
