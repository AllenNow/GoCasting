/* pages/species/species.wxss */

/* ===== 搜索栏 ===== */
.search-bar {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--color-border);
}

.search-input-full {
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: 100rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  width: 100%;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-hint);
  font-size: 26rpx;
}

/* ===== 科目 Tab ===== */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 20rpx 12rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--color-border);
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  margin-right: 12rpx;
  border: 2rpx solid transparent;
}

.cat-tab-active {
  background: var(--color-primary);
  color: #ffffff;
}

/* ===== 计数提示 ===== */
.count-hint {
  font-size: 22rpx;
  color: var(--color-text-hint);
  padding: 12rpx 24rpx 4rpx;
}

/* ===== 鱼种网格 ===== */
.species-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 12rpx 20rpx 20rpx;
}

.species-card {
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.species-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.species-icon       { font-size: 44rpx; }
.species-card-name  { font-size: 24rpx; font-weight: 600; color: var(--color-text-primary); text-align: center; line-height: 1.3; }
.species-card-pinyin{ font-size: 18rpx; color: var(--color-primary); text-align: center; letter-spacing: 0.5rpx; }
.species-card-latin { font-size: 16rpx; color: var(--color-text-hint); text-align: center; font-style: italic; }

.species-category-tag {
  font-size: 18rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
  margin-top: 2rpx;
}

/* ===== 详情弹窗 ===== */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.detail-panel {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx 32rpx 0 0;
  color: #fff;
  flex-shrink: 0;
}

.detail-icon { font-size: 56rpx; }

.detail-title-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail-name   { font-size: 34rpx; font-weight: 700; }
.detail-pinyin { font-size: 22rpx; opacity: 0.95; letter-spacing: 1rpx; }
.detail-latin  { font-size: 20rpx; opacity: 0.85; font-style: italic; }
.detail-en     { font-size: 20rpx; opacity: 0.7; }
.detail-close  { font-size: 28rpx; padding: 8rpx 12rpx; align-self: flex-start; }

/* 详情内容 */
.detail-body { flex: 1; padding: 0 24rpx 24rpx; overflow-y: auto; }

/* 俗称条 */
.alias-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff8e6;
  border-radius: var(--radius-sm);
  padding: 14rpx 20rpx;
  margin: 20rpx 0 8rpx;
}

.alias-label {
  font-size: 22rpx;
  color: var(--color-accent);
  font-weight: 600;
  flex-shrink: 0;
}

.alias-val {
  font-size: 24rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

/* 小标题 */
.section-title-sm {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  padding: 16rpx 0 4rpx;
}

.detail-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--color-border);
  gap: 16rpx;
}

.dr-label { font-size: 24rpx; color: var(--color-text-hint); width: 120rpx; flex-shrink: 0; }
.dr-val   { font-size: 26rpx; color: var(--color-text-primary); flex: 1; line-height: 1.5; }

/* 心得框 */
.tips-box {
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin: 20rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-label { font-size: 24rpx; font-weight: 600; color: var(--color-primary); }
.tips-text  { font-size: 24rpx; color: var(--color-text-primary); line-height: 1.7; }

.detail-action { padding: 8rpx 0 24rpx; }
