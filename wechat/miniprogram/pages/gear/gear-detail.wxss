/* pages/gear/gear-detail.wxss — 系列详情页样式 */

.detail-page {
  background: var(--color-card);
  min-height: 100vh;
}

/* ===== A. Hero 大图区 ===== */
.hero-section {
  width: 100%;
  background: var(--color-card);
}

/* 宽幅 banner — 约 2.5:1 比例，贴近网页版横幅感 */
.hero-banner-wrap {
  width: 100%;
  position: relative;
  overflow: hidden;
  background: #111111;
  padding-bottom: 40%; /* 撑开容器高度 */
}

.hero-banner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 品牌名/系列名叠加：左下角渐变蒙层 + 文字 */
.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 36rpx 24rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 100%);
}

.hero-brand-label {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.4);
  font-style: italic;
}

/* 占位（无 banner 图时） */
.hero-placeholder {
  width: 100%;
  height: 0;
  padding-bottom: 40%;
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  position: relative;
}

.hero-placeholder-text {
  position: absolute;
  bottom: 24rpx;
  left: 36rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-style: italic;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* 商品轮播图区（banner 下方的小图轮播） */
.product-gallery {
  width: 100%;
  background: #f5f5f5;
  border-top: 2rpx solid var(--color-border);
}

.gallery-swiper {
  width: 100%;
  height: 420rpx; /* 固定高度，swiper 组件不支持 padding-bottom */
}

.gallery-image {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
}

/* ===== B. 系列信息头 ===== */
.info-header {
  padding: 32rpx;
}

.info-top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-brand {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.info-tier {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.tier-1 { background: #f0f0f0; color: #666666; }
.tier-2 { background: #e6f0ff; color: #3a7bd5; }
.tier-3 { background: var(--color-primary-light); color: var(--color-primary); }
.tier-4 { background: #fff8e6; color: var(--color-accent); }
.tier-5 { background: #fdeaea; color: #c0392b; }
.tier-6 { background: #1a1a2e; color: #ffffff; }

.info-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  line-height: 1.4;
}

.info-price {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-accent);
  display: block;
  margin-top: 12rpx;
}

.info-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.info-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.info-market {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.pill-market-cn {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.pill-market-jdm {
  background: #fff8e6;
  color: var(--color-accent);
}

/* 描述区域 */
.info-desc-wrap {
  margin-top: 20rpx;
}

.info-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
  margin-top: 16rpx;
  white-space: pre-wrap;
}

.desc-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.desc-toggle {
  font-size: 24rpx;
  color: var(--color-primary);
  margin-top: 8rpx;
  display: inline-block;
}

/* ===== C. 详情 Tab 栏 ===== */
.detail-tab-bar {
  display: flex;
  border-bottom: 2rpx solid var(--color-border);
  padding: 0 32rpx;
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-card);
}

.detail-tab-item {
  padding: 24rpx 0;
  margin-right: 48rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  position: relative;
}

.detail-tab-active {
  color: var(--color-text-primary);
  font-weight: 600;
}

.detail-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary);
}

/* ===== 通用区块 ===== */
.section {
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

/* ===== C1. 产品技术 ===== */
.tech-section {
  padding-top: 24rpx;
}

/* 技术 Logo 网格 */
.tech-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding: 0 32rpx;
}

.tech-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tech-grid-active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.tech-grid-active .tech-logo-text {
  color: #ffffff;
}

.tech-logo-box {
  width: 100%;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tech-logo-img {
  width: 100%;
  height: 48rpx;
  object-fit: contain;
}

.tech-logo-text {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.3;
  word-break: break-all;
}

.tech-grid-active .tech-logo-text {
  color: #ffffff;
}

.tech-grid-active .tech-logo-img {
  /* 选中时图片加白色滤镜增加辨识度 */
  filter: brightness(10);
}

/* 技术详情 Swiper */
.tech-swiper {
  height: 320rpx;
  margin: 0 32rpx;
}

.tech-detail-card {
  display: flex;
  gap: 24rpx;
  padding: 20rpx;
  background: #1a1a1a;
  border-radius: var(--radius-md);
  height: 280rpx;
  overflow: hidden;
}

.tech-detail-img-wrap {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: #2a2a2a;
  position: relative;
}

.tech-detail-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.tech-detail-img-placeholder {
  width: 100%;
  height: 100%;
  background: #2a2a2a;
}

.tech-detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.tech-detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.tech-detail-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 7;
}

/* ===== C2. 产品阵容（渔轮） ===== */
.lineup-scroll {
  white-space: nowrap;
  padding: 0 0 16rpx;
}

.lineup-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 320rpx;
  margin-right: 16rpx;
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  vertical-align: top;
}

.lineup-model {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  white-space: normal;
}

.lineup-divider {
  width: 40rpx;
  height: 2rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}

.lineup-img-wrap {
  width: 260rpx;
  height: 200rpx;
  position: relative;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: #f8f8f8;
}

.lineup-img {
  width: 100%;
  height: 100%;
}

.lineup-img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
}

.lineup-img-placeholder-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.lineup-zoom {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  font-size: 28rpx;
}

.lineup-btn {
  margin-top: 16rpx;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-sm);
  text-align: center;
}

/* ===== C2. 产品特性（渔竿） ===== */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--color-bg);
}

.feature-img {
  width: 100%;
  height: 100%;
}

.feature-img-placeholder {
  width: 100%;
  height: 100%;
  background: var(--color-bg);
}

.feature-name {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.4;
}

/* ===== C3. 产品规格表 ===== */
.spec-section {
  padding-left: 0;
  padding-right: 0;
}

.spec-section .section-title {
  padding-left: 32rpx;
}

.spec-table-wrap {
  position: relative;
  overflow: hidden;
}

/* 右侧渐变阴影提示可滑动 */
.spec-scroll-hint {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 100%;
  background: linear-gradient(to left, rgba(0, 0, 0, 0.06), transparent);
  z-index: 10;
  pointer-events: none;
}

.spec-table-scroll {
  width: 100%;
  overflow-x: auto;
}

.spec-table {
  display: table;
  min-width: 100%;
  border-collapse: collapse;
}

.spec-row {
  display: table-row;
}

.spec-header {
  background: #1a1a1a;
}

.spec-row-alt {
  background: #f8faf8;
}

.spec-cell {
  display: table-cell;
  padding: 20rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
  vertical-align: middle;
  min-width: 140rpx;
}

.spec-header .spec-cell {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: #1a1a1a;
}

/* 首列固定 */
.spec-cell-sticky {
  position: sticky;
  left: 0;
  z-index: 5;
  background: #ffffff;
  font-weight: 600;
  min-width: 180rpx;
  border-right: 2rpx solid var(--color-border);
}

.spec-header-sticky {
  background: #1a1a1a !important;
  z-index: 6;
}

.spec-row-alt .spec-cell-sticky {
  background: #f8faf8;
}

/* 价格列右对齐 */
.spec-cell-price {
  text-align: right;
  color: var(--color-accent);
  font-weight: 500;
}

/* ===== 补充资料 ===== */
.docs-section {
  padding: 24rpx 32rpx;
}

.doc-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.doc-icon {
  font-size: 32rpx;
}

.doc-title {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

/* ===== 公共复用 ===== */
.divider {
  height: 2rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}

/* empty-state 和 loading-wrap 已在 app.wxss 全局定义 */
