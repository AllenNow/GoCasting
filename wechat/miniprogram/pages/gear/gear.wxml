<!-- pages/gear/gear.wxml — 装备列表页 -->
<wxs module="utils" src="./fmt.wxs"></wxs>

<!-- 顶部固定区域：直接作为页面根级元素，sticky 才能对 page 滚动生效 -->
<view class="header-sticky">

  <!-- Tab 切换栏 -->
  <view class="gear-tab-bar">
    <view class="gear-tab-item {{activeTab === 'rod' ? 'gear-tab-active' : ''}}"
          bindtap="switchTab" data-tab="rod">渔竿</view>
    <view class="gear-tab-item {{activeTab === 'reel' ? 'gear-tab-active' : ''}}"
          bindtap="switchTab" data-tab="reel">渔轮</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索型号、规格、价格…"
           value="{{keyword}}" bindinput="onSearchInput"
           confirm-type="search" />
  </view>

  <!-- 第一行：价位筛选 -->
  <view class="filter-row-price">
    <scroll-view scroll-x class="filter-scroll-inner" enable-flex>
      <view wx:for="{{prices}}" wx:key="value"
            class="price-pill {{priceIdx === index ? 'price-pill-active' : ''}}"
            bindtap="onPriceChange" data-idx="{{index}}">{{item.label}}</view>
    </scroll-view>
  </view>

  <!-- 第二行：品牌 + 市场 + 类型 -->
  <view class="filter-row-sub">
    <scroll-view scroll-x class="filter-scroll-inner" enable-flex>
      <view wx:for="{{brands}}" wx:key="*this"
            class="sub-pill {{brandIdx === index ? 'sub-pill-active' : ''}}"
            bindtap="onBrandChange" data-idx="{{index}}">{{item}}</view>
      <view class="sub-divider"></view>
      <view wx:for="{{markets}}" wx:key="value"
            class="sub-pill {{marketIdx === index ? 'sub-pill-active' : ''}}"
            bindtap="onMarketChange" data-idx="{{index}}">{{item.label}}</view>
      <block wx:if="{{showTypePill}}">
        <view class="sub-divider"></view>
        <view wx:for="{{types}}" wx:key="value"
              class="sub-pill {{typeIdx === index ? 'sub-pill-active' : ''}}"
              bindtap="onTypeChange" data-idx="{{index}}">{{item.label}}</view>
      </block>
    </scroll-view>
  </view>

  <!-- 已筛选提示 + 重置 -->
  <view wx:if="{{brandIdx > 0 || typeIdx > 0 || priceIdx > 0 || marketIdx > 0}}"
        class="filter-active-bar">
    <text class="filter-active-text">已筛选 · {{filteredList.length}} 个结果</text>
    <view class="filter-reset" bindtap="resetFilters">重置</view>
  </view>

</view>

<!-- 内容区：独立容器，不包在 header-sticky 里 -->
<view class="gear-content">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中…</text>
  </view>

  <view wx:elif="{{!seeded}}" class="seed-wrap card">
    <text class="seed-icon">📦</text>
    <text class="seed-hint">装备数据库为空</text>
    <text class="seed-sub">点击下方按钮从内置数据初始化</text>
    <view class="btn-primary seed-btn" bindtap="seedData">初始化装备数据</view>
  </view>

  <view wx:elif="{{filteredList.length === 0}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">没有符合条件的装备</text>
    <text class="empty-subtext" wx:if="{{keyword}}">未找到相关装备，试试其他关键词</text>
  </view>

  <view wx:else class="series-list">
    <view wx:for="{{filteredList}}" wx:key="series_id"
          class="series-card" bindtap="onCardTap" data-id="{{item.series_id}}">
      <view class="card-image-wrap">
        <image wx:if="{{item.images && item.images.length > 0 && item.images[0]}}"
               class="card-image" src="{{item.images[0]}}" mode="aspectFill" lazy-load />
        <view wx:else class="card-image-placeholder">
          <text class="placeholder-text">{{item.series_name}}</text>
        </view>
        <view class="card-pills">
          <view wx:if="{{item.type_label && showTypePill}}" class="card-pill pill-type">{{item.type_label}}</view>
          <view class="card-pill pill-market-{{item.market === 'CN' ? 'cn' : 'jdm'}}">
            {{item.market === 'CN' ? '中国行货' : 'JDM'}}
          </view>
        </view>
      </view>
      <view class="card-info">
        <view class="card-info-top">
          <view class="card-meta">
            <text class="card-brand">{{item.brand}}</text>
            <text class="card-name">{{item.series_name}}</text>
            <text class="card-price">{{utils.priceRange(item.price_min, item.price_max)}}</text>
            <text class="card-sub">{{item.year ? item.year + '款 · ' : ''}}{{item.model_count}}个型号</text>
          </view>
          <view class="card-tier tier-{{item.price_tier}}">{{utils.tierLabel(item.price_tier)}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
