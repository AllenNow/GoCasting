/* pages/gear/gear.wxss — 装备列表页样式 */

/* ===== 顶部 sticky 容器（直接是 page 根级子元素，sticky 才生效）===== */
.header-sticky {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-border);
}

/* ===== 内容区 ===== */
.gear-content {
  background: var(--color-bg);
  min-height: 100vh;
}

/* ===== 渔竿 / 渔轮 分段切换 ===== */
.gear-tab-wrap {
  padding: 20rpx 24rpx 6rpx;
  background: var(--color-card);
}

.gear-segment {
  display: flex;
  padding: 6rpx;
  background: var(--color-bg);
  border-radius: 100rpx;
}

.gear-tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border-radius: 100rpx;
  transition: all 0.2s ease;
}

.gear-tab-active {
  color: var(--color-primary);
  font-weight: 600;
  background: var(--color-card);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* ===== 搜索 + 筛选入口 ===== */
.search-filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 12rpx;
  background: var(--color-card);
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: 100rpx;
}

.search-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 26rpx;
  line-height: 1;
  opacity: 0.55;
}

/* 覆盖全局 .search-input 的整行输入框样式 */
.search-box .search-input {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 68rpx;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  font-size: 26rpx;
  line-height: 68rpx;
  color: var(--color-text-primary);
}

.filter-trigger {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 100rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 500;
}

.filter-trigger-icon {
  font-size: 24rpx;
  line-height: 1;
}

.filter-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 100rpx;
  background: var(--color-accent);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ===== 品牌快捷筛选 ===== */
.brand-row {
  background: var(--color-card);
}

.brand-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.sub-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 26rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border: 2rpx solid transparent;
  margin-right: 12rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.sub-pill-active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* ===== 已筛选提示条 ===== */
.filter-active-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  background: var(--color-primary-light);
}

.filter-active-text {
  font-size: 22rpx;
  color: var(--color-primary);
}

.filter-reset {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 4rpx 20rpx;
  background: rgba(26, 127, 90, 0.12);
  border-radius: 100rpx;
}

/* ===== 结果条 ===== */
.result-bar {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 20rpx 28rpx 0;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.result-keyword {
  color: var(--color-primary);
}

/* ===== 筛选底部弹层 ===== */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  max-height: 76vh;
  background: var(--color-card);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: sheet-up 0.22s ease-out;
}

@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.sheet-close {
  padding: 8rpx 12rpx;
  font-size: 32rpx;
  color: var(--color-text-hint);
  line-height: 1;
}

.sheet-body {
  max-height: 52vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.filter-group {
  padding: 20rpx 0 8rpx;
}

.filter-group-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.filter-group-hint {
  display: block;
  margin-top: -10rpx;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-hint);
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sheet-chip {
  padding: 14rpx 30rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  line-height: 1.2;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border: 2rpx solid transparent;
}

.sheet-chip-active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  font-weight: 500;
}

.sheet-footer {
  flex-shrink: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.sheet-reset {
  flex: 0 0 200rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.sheet-apply {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 100rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--color-primary);
}

/* ===== 系列卡片列表 ===== */
.series-list {
  padding: 16rpx 20rpx;
}

.series-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 卡片图片区域 */
.card-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%; /* 16:9 */
  overflow: hidden;
}

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.card-image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a7f5a 0%, #0d5c42 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.placeholder-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 40rpx;
  opacity: 0.9;
}

/* 右上角标签组 */
.card-pills {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 8rpx;
}

.card-pill {
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.pill-type {
  background: rgba(255, 255, 255, 0.92);
  color: var(--color-text-secondary);
}

.pill-market-cn {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.pill-market-jdm {
  background: #fff8e6;
  color: var(--color-accent);
}

/* 卡片信息区 */
.card-info {
  padding: 20rpx 24rpx 24rpx;
}

.card-info-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.card-brand {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.card-price {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-accent);
  margin-top: 4rpx;
}

.card-price-empty {
  color: var(--color-text-hint);
  font-size: 24rpx;
}

.card-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

/* ===== 初始化提示 ===== */
.seed-wrap {
  margin: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 32rpx;
}

.seed-icon {
  font-size: 64rpx;
}

.seed-hint {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.seed-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.seed-btn {
  margin-top: 24rpx;
  padding: 22rpx 60rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
}

.data-disclaimer {
  padding: 16rpx 40rpx 40rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #aaa;
  text-align: center;
}
