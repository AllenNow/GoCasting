/* pages/go-score/go-score.wxss */

/* 顶部英雄区 */
.score-hero {
  background: linear-gradient(135deg, #1a7f5a, #0d5c42);
  padding: 40rpx 32rpx 56rpx;
  color: #fff;
  text-align: center;
}
.score-date {
  font-size: 24rpx;
  opacity: 0.75;
  margin-bottom: 24rpx;
}
.big-score-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  margin-bottom: 12rpx;
}
.big-score {
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1;
  color: #ffffff;
}
.big-score-max {
  font-size: 36rpx;
  color: rgba(255,255,255,0.6);
}
.score-level {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
}
.error-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.65);
  display: block;
  margin-top: 12rpx;
}
.hero-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}
.sk-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(255,255,255,0.1) 25%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0.1) 75%);
  background-size: 400% 100%;
  animation: shimmer 1.4s infinite;
}

/* 4因子 */
.factors-card { margin: -28rpx 24rpx 16rpx; }
.factors-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.factor-item {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.factor-icon { font-size: 36rpx; }
.factor-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.factor-weight {
  font-size: 20rpx;
  color: var(--color-text-hint);
  font-weight: 400;
}
.factor-desc {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
.stars-row {
  display: flex;
  gap: 6rpx;
  margin-top: 4rpx;
}
.star {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.star-on  { background: var(--color-primary); }
.star-off { background: #e0e0e0; }

/* 最佳时段 */
.best-card { margin: 0 24rpx 16rpx; }
.best-list { display: flex; flex-direction: column; gap: 12rpx; margin-top: 8rpx; }
.best-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.best-time {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  width: 100rpx;
  flex-shrink: 0;
}
.best-tide { font-size: 28rpx; flex-shrink: 0; }
.best-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: var(--color-bg);
  border-radius: 100rpx;
  overflow: hidden;
}
.best-bar {
  height: 100%;
  background: var(--color-primary);
  border-radius: 100rpx;
  transition: width 0.5s ease;
}
.best-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  width: 48rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 24小时趋势 */
.trend-card { margin: 0 24rpx 16rpx; }
.trend-scroll { width: 100%; }
.trend-bars {
  display: flex;
  align-items: flex-end;
  gap: 0;
  padding-bottom: 36rpx;
  width: max-content;
}
.trend-col {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}
.trend-score-num { font-size: 18rpx; }
.trend-bar {
  width: 32rpx;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 8rpx;
}
.bar-great { background: #1a7f5a; }
.bar-good  { background: #52a875; }
.bar-ok    { background: #f0a500; }
.bar-bad   { background: #e0e0e0; }
.trend-hour {
  position: absolute;
  bottom: -28rpx;
  font-size: 18rpx;
  color: var(--color-text-hint);
}

/* 操作按钮 */
.action-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: var(--radius-md);
  line-height: normal;
}
